<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
/* ====== SIDEBAR & NAVIGATION ====== */
let _sidebarCollapsed = false;
function toggleSidebar() {
  const sidebar = document.getElementById('sidebar');
  const main = document.getElementById('mainContent');
  const overlay = document.getElementById('sidebarOverlay');
  if (window.innerWidth <= 768) {
    sidebar.classList.toggle('mobile-open');
    overlay.classList.toggle('show');
  } else {
    _sidebarCollapsed = !_sidebarCollapsed;
    sidebar.classList.toggle('collapsed', _sidebarCollapsed);
    main.classList.toggle('expanded', _sidebarCollapsed);
  }
}
function closeSidebar() {
  document.getElementById('sidebar').classList.remove('mobile-open');
  document.getElementById('sidebarOverlay').classList.remove('show');
}
function showSection(name) {
  document.querySelectorAll('.section-page').forEach(function(el) { el.classList.remove('active'); });
  document.querySelectorAll('.nav-item').forEach(function(el) { el.classList.remove('active'); });
  const section = document.getElementById('section-' + name);
  if (section) section.classList.add('active');
  const navItem = document.getElementById('nav-' + name);
  if (navItem) navItem.classList.add('active');
  if (name === 'config') { loadFlowData(); loadSlogans(); }
  else if (name === 'ids') { loadIdList(1); refreshIdStats(); }
  else if (name === 'bots') { loadBotHealth(null); }
  else if (name === 'analytics') { loadAnalytics(null); }
  else if (name === 'script') { loadScriptData(); }
  closeSidebar();
  window.location.hash = name;
}
function showConfigTab(tab) {
  ['slogans','flow','miniapp'].forEach(function(t) {
    document.getElementById('config-tab-' + t).style.display = t === tab ? '' : 'none';
    document.getElementById('tab-' + t + '-btn').classList.toggle('active', t === tab);
  });
}
/* ====== CLOCK ====== */
function updateClock() {
  const el = document.getElementById('dashClock');
  if (el) el.textContent = new Date().toLocaleString('vi-VN', { timeZone: 'Asia/Ho_Chi_Minh' });
}
setInterval(updateClock, 1000); updateClock();
/* ====== TOAST ====== */
function escapeHtml(str) {
  return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}
function showToast(message, type) {
  const container = document.getElementById('toastContainer');
  const id = 'toast_' + Date.now();
  const bgClass = type === 'success' ? 'bg-success' : 'bg-danger';
  const icon = type === 'success' ? 'bi-check-circle-fill' : 'bi-x-circle-fill';
  container.insertAdjacentHTML('beforeend','<div id="'+id+'" class="toast align-items-center text-white '+bgClass+' border-0" role="alert"><div class="d-flex"><div class="toast-body"><i class="bi '+icon+' me-2"></i>'+escapeHtml(message)+'</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div></div>');
  const toastEl = document.getElementById(id);
  const toast = new bootstrap.Toast(toastEl, { delay: 4500 });
  toast.show();
  toastEl.addEventListener('hidden.bs.toast', function() { toastEl.remove(); });
}
/* ====== ALBUM HELPERS ====== */
function toggleAddPost(albumId) {
  const panel = document.getElementById('add-post-panel-' + albumId);
  panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
}
function previewImages(event, albumId) { renderPreviews(event.target.files, albumId); }
function previewMedia(event, albumId) { renderPreviews(event.target.files, albumId); }
function handleDrop(event, albumId) {
  event.preventDefault();
  document.getElementById('dz-' + albumId).classList.remove('dragover');
  try { const dt = new DataTransfer(); for (const f of event.dataTransfer.files) dt.items.add(f); document.getElementById('fi-' + albumId).files = dt.files; renderPreviews(event.dataTransfer.files, albumId); } catch(e) {}
}
function renderPreviews(files, albumId) {
  const preview = document.getElementById('preview-' + albumId);
  preview.innerHTML = '';
  for (const file of files) {
    if (file.type.startsWith('image/')) {
      const img = document.createElement('img');
      img.src = URL.createObjectURL(file);
      img.style.cssText = 'width:70px;height:70px;object-fit:cover;border-radius:6px;border:1px solid #2a2d35;';
      preview.appendChild(img);
    } else if (file.type.startsWith('video/')) {
      const div = document.createElement('div');
      div.style.cssText = 'width:70px;height:70px;border-radius:6px;border:1px solid #2a2d35;background:#0f1117;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:.65rem;color:#aaa;gap:2px;flex-shrink:0;';
      div.innerHTML = '<i class="bi bi-camera-video-fill" style="font-size:1.4rem;color:#4d9fff;"></i><span>Video</span>';
      preview.appendChild(div);
    }
  }
}
function showSpinner(form) { const s = form.querySelector('.upload-spinner'); if (s) s.style.display = 'inline-block'; }
/* ====== LIGHTBOX ====== */
function openLightbox(src) { document.getElementById('lightbox-img').src = src; document.getElementById('lightbox').classList.add('show'); }
function closeLightbox() { document.getElementById('lightbox').classList.remove('show'); }
document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeLightbox(); });
/* ====== BOT MANAGEMENT ====== */
async function loadBotHealth(btn) {
  const origHtml = btn ? btn.innerHTML : '';
  if (btn) { btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span>Đang kiểm tra...'; }
  try {
    const res = await fetch('/bots/health'); if (!res.ok) throw new Error('HTTP ' + res.status);
    const bots = await res.json();
    bots.forEach(function(bot) {
      const statusEl = document.getElementById('bot-status-' + bot.id);
      const subsEl = document.getElementById('bot-subs-' + bot.id);
      const msgsEl = document.getElementById('bot-msgs-' + bot.id);
      const startsEl = document.getElementById('bot-starts-' + bot.id);
      const interEl = document.getElementById('bot-interactions-' + bot.id);
      const repEl = document.getElementById('bot-replies-' + bot.id);
      if (statusEl) { const icons={LIVE:'&#128994;',BAN:'&#128308;',ERROR:'&#128992;'},cls={LIVE:'status-live',BAN:'status-ban',ERROR:'status-error'}; statusEl.innerHTML='<span class="'+( cls[bot.status]||'status-error')+'">'+( icons[bot.status]||'&#128992;')+' '+bot.status+'</span>'; }
      if (subsEl) subsEl.textContent = bot.subs_count ?? '—';
      if (msgsEl) msgsEl.textContent = bot.messages_sent ?? '—';
      if (startsEl) startsEl.textContent = bot.starts_count ?? '—';
      if (interEl) interEl.textContent = bot.interactions_count ?? '—';
      if (repEl) repEl.textContent = bot.replies_count ?? '—';
    });
    if (btn) showToast('&#9989; Đã cập nhật trạng thái bot!', 'success');
  } catch(e) { if (btn) showToast('&#10060; Lỗi: ' + e.message, 'error'); }
  finally { if (btn) { btn.disabled = false; btn.innerHTML = origHtml; } }
}
async function toggleAutoResponder(botId, checkbox) {
  const label = document.getElementById('ar-label-' + botId);
  checkbox.disabled = true;
  try {
    const res = await fetch('/bots/' + botId + '/toggle_responder', { method: 'POST' });
    const data = await res.json();
    if (data.ok) {
      checkbox.checked = data.auto_responder;
      if (label) label.textContent = data.auto_responder ? 'Bật' : 'Tắt';
      showToast('&#9989; Auto-Responder ' + (data.auto_responder ? 'đã bật' : 'đã tắt'), 'success');
    } else {
      checkbox.checked = !checkbox.checked; // revert
      showToast('&#10060; ' + (data.error || '?'), 'error');
    }
  } catch(e) { checkbox.checked = !checkbox.checked; showToast('&#10060; Lỗi: ' + e.message, 'error'); }
  finally { checkbox.disabled = false; }
}
async function loadAnalytics(btn) {
  const origHtml = btn ? btn.innerHTML : '';
  if (btn) { btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span>Đang tải...'; }
  try {
    const res = await fetch('/analytics/data'); if (!res.ok) throw new Error('HTTP ' + res.status);
    const data = await res.json();
    if (!data.ok) throw new Error(data.error || '?');
    const t = data.totals;
    const startEl = document.getElementById('agg-starts');
    const sentEl = document.getElementById('agg-sent');
    const intEl = document.getElementById('agg-interactions');
    const repEl = document.getElementById('agg-replies');
    if (startEl) startEl.textContent = t.starts_count ?? 0;
    if (sentEl) sentEl.textContent = t.messages_sent ?? 0;
    if (intEl) intEl.textContent = t.interactions_count ?? 0;
    if (repEl) repEl.textContent = t.replies_count ?? 0;
    const tbody = document.getElementById('analyticsTableBody');
    if (tbody) {
      if (!data.bots || data.bots.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-4">Chưa có dữ liệu analytics</td></tr>';
      } else {
        tbody.innerHTML = data.bots.map(function(b) {
          return '<tr>' +
            '<td class="ps-3"><i class="bi bi-robot me-2" style="color:var(--accent);"></i>' + escapeHtml(b.name) + '</td>' +
            '<td class="text-center">' + (b.starts_count || 0) + '</td>' +
            '<td class="text-center">' + (b.messages_sent || 0) + '</td>' +
            '<td class="text-center">' + (b.interactions_count || 0) + '</td>' +
            '<td class="text-center">' + (b.replies_count || 0) + '</td>' +
            '</tr>';
        }).join('');
      }
    }
    if (btn) showToast('&#9989; Đã cập nhật analytics!', 'success');
  } catch(e) { if (btn) showToast('&#10060; Lỗi: ' + e.message, 'error'); }
  finally { if (btn) { btn.disabled = false; btn.innerHTML = origHtml; } }
}
const _tokenVisible = {};
async function toggleTokenView(botId, btn) {
  const maskEl = document.getElementById('bot-token-mask-' + botId);
  const fullEl = document.getElementById('bot-token-full-' + botId);
  if (!maskEl || !fullEl) return;
  if (_tokenVisible[botId]) {
    // Hide token
    maskEl.style.display = ''; fullEl.style.display = 'none';
    _tokenVisible[botId] = false; btn.innerHTML = '<i class="bi bi-eye"></i>';
    return;
  }
  // Show token – fetch from server
  const origHtml = btn.innerHTML; btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span>';
  try {
    const res = await fetch('/bots/' + botId + '/token'); const data = await res.json();
    if (data.ok) {
      fullEl.textContent = data.token; maskEl.style.display = 'none'; fullEl.style.display = '';
      _tokenVisible[botId] = true; btn.innerHTML = '<i class="bi bi-eye-slash"></i>';
    } else { showToast('&#10060; ' + (data.error || '?'), 'error'); btn.innerHTML = origHtml; }
  } catch(e) { showToast('&#10060; Lỗi: ' + e.message, 'error'); btn.innerHTML = origHtml; }
  finally { btn.disabled = false; }
}
async function doAddBot(btn) {
  const name = document.getElementById('botName').value.trim(), token = document.getElementById('botToken').value.trim(), adminId = document.getElementById('botAdminId').value.trim();
  if (!name || !token) { showToast('&#9888;&#65039; Tên và Token không được để trống', 'error'); return; }
  const origHtml = btn.innerHTML; btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span>Đang thêm...';
  try {
    const form = new FormData(); form.append('name', name); form.append('token', token); if (adminId) form.append('admin_id', adminId);
    const res = await fetch('/bots/add', { method: 'POST', body: form }); const data = await res.json();
    if (data.ok) { showToast('&#9989; Đã thêm bot! Bot sẽ tự động bắt đầu polling trong vòng 30 giây.', 'success'); bootstrap.Modal.getInstance(document.getElementById('addBotModal')).hide(); setTimeout(function() { location.reload(); }, 1500); }
    else { showToast('&#10060; ' + (data.error || '?'), 'error'); }
  } catch(e) { showToast('&#10060; Lỗi: ' + e.message, 'error'); }
  finally { btn.disabled = false; btn.innerHTML = origHtml; }
}
async function doDeleteBot(botId, botName, btn) {
  if (!confirm('Xóa bot «' + botName + '»?')) return;
  const origHtml = btn.innerHTML; btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span>';
  try {
    const res = await fetch('/bots/' + botId + '/delete', { method: 'POST' }); const data = await res.json();
    if (data.ok) { showToast('&#9989; Đã xóa bot!', 'success'); setTimeout(function() { location.reload(); }, 1500); }
    else { showToast('&#10060; ' + (data.error || '?'), 'error'); btn.disabled = false; btn.innerHTML = origHtml; }
  } catch(e) { showToast('&#10060; Lỗi: ' + e.message, 'error'); btn.disabled = false; btn.innerHTML = origHtml; }
}
/* ====== ID MANAGEMENT ====== */
let _idFileSelected = null, _idCurrentPage = 1, _idBroadcastInterval = null;
function handleIdFileSelect(event) {
  const file = event.target.files[0]; if (!file) return;
  _idFileSelected = file;
  document.getElementById('idFileName').textContent = '&#128196; ' + file.name;
  document.getElementById('idFileName').style.display = '';
  document.getElementById('btnUploadIds').disabled = false;
}
function handleIdFileDrop(event) {
  event.preventDefault(); document.getElementById('idDropZone').classList.remove('dragover');
  const file = event.dataTransfer.files[0];
  if (file) { _idFileSelected = file; document.getElementById('idFileName').textContent = '&#128196; ' + file.name; document.getElementById('idFileName').style.display = ''; document.getElementById('btnUploadIds').disabled = false; }
}
async function doUploadIds(btn) {
  if (!_idFileSelected) { showToast('&#9888;&#65039; Chưa chọn file', 'error'); return; }
  const origHtml = btn.innerHTML; btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span>Đang tải lên...';
  try {
    const form = new FormData(); form.append('file', _idFileSelected);
    const res = await fetch('/ids/upload', { method: 'POST', body: form }); const data = await res.json();
    if (data.ok) {
      showToast('&#9989; Đã tải ' + data.inserted + ' ID mới (bỏ qua ' + data.skipped + ' trùng)!', 'success');
      _idFileSelected = null; document.getElementById('idFileName').style.display = 'none';
      loadIdList(1); refreshIdStats();
    } else { showToast('&#10060; ' + (data.error || '?'), 'error'); }
  } catch(e) { showToast('&#10060; Lỗi: ' + e.message, 'error'); }
  finally { btn.disabled = false; btn.innerHTML = origHtml; }
}
async function refreshIdStats() {
  try {
    const res = await fetch('/ids/stats'); const s = await res.json();
    ['total','active','blocked','invalid'].forEach(function(k) { const el = document.getElementById('idStat-' + k); if (el) el.textContent = s[k] ?? 0; });
  } catch(e) {}
}
async function loadIdList(page) {
  _idCurrentPage = page || 1;
  const statusFilter = document.getElementById('idStatusFilter') ? document.getElementById('idStatusFilter').value : '';
  const url = '/ids?page=' + _idCurrentPage + '&per_page=50' + (statusFilter ? '&status=' + statusFilter : '');
  const container = document.getElementById('idListContainer');
  container.innerHTML = '<div class="text-center py-4"><span class="spinner-border spinner-border-sm me-2" role="status"></span>Đang tải...</div>';
  try {
    const res = await fetch(url); const data = await res.json();
    if (!data.ok || !data.items || data.items.length === 0) {
      container.innerHTML = '<div class="empty-state py-4"><i class="bi bi-people"></i><p>Chưa có ID nào.' + (statusFilter ? ' (bộ lọc: ' + statusFilter + ')' : '') + '</p></div>'; return;
    }
    const statusMap = { active: '<span class="status-badge status-active">&#9989; Active</span>', blocked: '<span class="status-badge status-blocked">&#128683; Blocked</span>', invalid: '<span class="status-badge status-invalid">&#10060; Invalid</span>', unknown: '<span class="status-badge status-unknown">&#9634; Unknown</span>' };
    let html = '<div class="table-responsive"><table class="table table-dark table-borderless data-table mb-0"><thead><tr><th class="ps-3">User ID</th><th>Trạng thái</th><th>Cập nhật</th></tr></thead><tbody>';
    data.items.forEach(function(item) {
      const badge = statusMap[item.status] || item.status;
      const updated = item.updated_at ? item.updated_at.substring(0,10) : '&#8212;';
      html += '<tr><td class="ps-3 font-monospace" style="font-size:.82rem;">' + escapeHtml(item.user_id) + '</td><td>' + badge + '</td><td style="font-size:.78rem;color:#888;">' + updated + '</td></tr>';
    });
    html += '</tbody></table></div>';
    container.innerHTML = html;
    const totalPages = Math.ceil(data.total / data.per_page);
    document.getElementById('idPaginationInfo').textContent = 'Tổng: ' + data.total + ' · Trang ' + data.page + '/' + totalPages;
    const btns = document.getElementById('idPaginationBtns'); btns.innerHTML = '';
    if (totalPages > 1) {
      if (page > 1) btns.insertAdjacentHTML('beforeend', '<button class="btn btn-sm btn-outline-secondary" onclick="loadIdList(' + (page-1) + ')">&#8249;</button>');
