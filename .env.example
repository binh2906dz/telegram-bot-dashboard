# ============================================================
# Telegram Bot Dashboard – environment variable template
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#   chmod 600 .env
#
# The application recognises all three token variable names
# (TELEGRAM_BOT_TOKEN takes precedence, then TOKEN, then BOT_TOKEN).
# Setting all three avoids any name-mismatch issues.
# ============================================================

# Your Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
TOKEN=
BOT_TOKEN=

# Public base URL for webhooks & Mini App (at least one required in production).
# DOMAIN / APP_BASE_URL may be https://example.com — used to build WEBHOOK_URL internally.
DOMAIN=https://example.com
APP_BASE_URL=https://example.com
# Optional explicit override (highest precedence):
# WEBHOOK_URL=https://example.com

# Optional: Telegram user ID to receive admin notifications
ADMIN_CHAT_ID=

# Optional: Web dashboard credentials (change before deploying!)
OWNER_USER=admin
OWNER_PASS=changeme
MANAGER_USER=quanly
MANAGER_PASS=changeme

# Required in production: stable Flask session + CSRF (dashboard forms / fetch POST).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# If DOMAIN/APP_BASE_URL/WEBHOOK_URL is set but SECRET_KEY is empty, the app logs an error (sessions reset on each process restart).
SECRET_KEY=
