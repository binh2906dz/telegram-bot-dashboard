<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Danh mục Album 🔥</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <style>
    :root { --bg: #0f0f0f; --card: #1a1a1a; --text: #f0f0f0; --accent: #ff5e00; }
    body { font-family: sans-serif; background: var(--bg); color: var(--text); margin: 0; padding: 20px; padding-bottom: 50px; }
    .header { text-align: center; margin-bottom: 30px; }
    .header h1 { color: var(--accent); font-weight: 800; font-size: 1.8rem; margin:0; text-transform: uppercase; }
    .header p { color: #888; font-size: 0.9rem; margin-top: 5px; }
    .category-box { background: var(--card); border: 1px solid #333; border-radius: 12px; margin-bottom: 20px; overflow: hidden; }
    .category-title { background: rgba(255,94,0,0.1); padding: 12px 16px; font-weight: bold; color: var(--accent); display: flex; align-items: center; border-bottom: 1px solid #333; }
    .album-list { padding: 10px; display: flex; flex-direction: column; gap: 10px; }
    .album-item { display: flex; justify-content: space-between; align-items: center; background: #222; padding: 12px 15px; border-radius: 8px; text-decoration: none; color: #fff; transition: background 0.2s; }
    .album-item:hover { background: #333; }
    .album-name { font-weight: 600; font-size: 0.95rem; display: flex; align-items: center; gap: 10px; }
    .album-count { font-size: 0.75rem; color: #aaa; background: #111; padding: 3px 8px; border-radius: 12px; }
  </style>
</head>
<body>
  <div class="header">
    <h1>🔥 KHO LINK VIP 🔥</h1>
    <p>Chọn một Album bên dưới để xem tiếp</p>
  </div>

  {% for cat in categories %}
    <div class="category-box">
      <div class="category-title"><i class="bi bi-folder-fill me-2"></i>{{ cat.name }}</div>
      <div class="album-list">
        {% set count = namespace(value=0) %}
        {% for album_id, album in albums.items() %}
          {% if album is mapping and album.get('category_id') == cat.id %}
            {% set count.value = count.value + 1 %}
            <a href="/view/album/{{ album_id }}?token={{ album_tokens.get(album_id, token) }}" class="album-item">
              <span class="album-name"><i class="bi bi-fire" style="color:#ffc107;"></i>{{ album.get('title', 'Album') }}</span>
              <span class="album-count">{{ album.get('posts', [])|length }} bài</span>
            </a>
          {% endif %}
        {% endfor %}
        {% if count.value == 0 %}
          <div style="text-align:center; padding:10px; color:#666; font-size:0.85rem;">Chưa có link nào</div>
        {% endif %}
      </div>
    </div>
  {% endfor %}
</body>
</html>