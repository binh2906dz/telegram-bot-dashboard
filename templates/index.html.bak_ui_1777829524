            {% for cat in categories %}
            <li class="list-group-item d-flex justify-content-between align-items-center" style="background:#1a1d23; border-color:#2a2d35; color:#eee;">
              <span><i class="bi bi-folder-fill me-2" style="color:#ffc107;"></i>{{ cat.name }}</span>
              <form action="/categories/{{ cat.id }}/delete" method="post" onsubmit="return confirm('Xóa danh mục này? (Các album bên trong sẽ thành album độc lập)')">
                <button class="btn btn-sm btn-outline-danger" style="padding:2px 8px;"><i class="bi bi-trash3"></i></button>
              </form>
            </li>
