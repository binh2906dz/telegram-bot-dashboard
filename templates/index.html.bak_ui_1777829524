    <div class="modal-content">
      <form action="/albums/create" method="post">
        <div class="modal-header"><h5 class="modal-title"><i class="bi bi-folder-plus me-2" style="color:var(--accent);"></i>Tạo Album mới</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
          <div class="mb-3"><label class="form-label fw-semibold">Tên Album <span class="text-danger">*</span></label><input name="title" class="form-control" placeholder="VD: Album tháng 4" required autofocus></div>
          
