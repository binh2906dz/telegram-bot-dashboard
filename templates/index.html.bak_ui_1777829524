/* ====== FLOW BUILDER ====== */
let _flowData = {};
async function loadFlowData() {
  try { const res = await fetch('/messages'); if (!res.ok) return; _flowData = await res.json(); renderNodeList(); }
  catch(e) { console.error('Failed to load flow:', e); }
}
function renderNodeList() {
  const container = document.getElementById('flowNodesList'); if (!container) return;
  const nodeIds = Object.keys(_flowData);
  if (nodeIds.length === 0) { container.innerHTML = '<div class="empty-state py-3"><i class="bi bi-chat-dots"></i><p class="mt-2 mb-0">Chưa có kịch bản nào.</p></div>'; return; }
  nodeIds.sort(function(a,b){ return a==='start'?-1:b==='start'?1:a.localeCompare(b); });
  let html = '<div class="list-group list-group-flush">';
  for (const nodeId of nodeIds) {
    const node = _flowData[nodeId] || {}; const text = (node.text||'').replace(/\n/g,' ').substring(0,70); const btns = node.buttons||[]; const isStart = nodeId==='start';
    let arrows = ''; for (const btn of btns) arrows += btn.type==='node' ? '<span class="badge bg-primary me-1" style="font-size:.68rem;">&#8594; '+escapeHtml(btn.value)+'</span>' : '<span class="badge bg-secondary me-1" style="font-size:.68rem;">&#128279; URL</span>';
    html += '<div class="list-group-item py-3" style="background:transparent;border-color:var(--border-color);"><div class="d-flex align-items-start gap-3 flex-wrap"><div class="flex-grow-1" style="min-width:0;"><div class="d-flex align-items-center gap-2 mb-1 flex-wrap"><code style="color:var(--accent);font-size:.88rem;">'+escapeHtml(nodeId)+'</code>'+( isStart?'<span class="badge bg-warning text-dark" style="font-size:.65rem;">START</span>':'')+'<span class="text-muted" style="font-size:.75rem;"><i class="bi bi-grid me-1"></i>'+btns.length+' nút</span></div><div class="text-muted text-truncate" style="font-size:.82rem;max-width:100%;">'+( text?escapeHtml(text)+((node.text||'').length>70?'&#8230;':''): '<em>Chưa có nội dung</em>')+'</div>'+( arrows?'<div class="mt-1">'+arrows+'</div>':'' )+'</div><div class="d-flex gap-1 flex-shrink-0 mt-1"><button class="btn btn-sm btn-outline-primary" onclick="openEditNode(\''+ escapeHtml(nodeId)+'\')" title="Sửa"><i class="bi bi-pencil"></i></button>'+( !isStart?'<button class="btn btn-sm btn-outline-danger" onclick="doDeleteNode(\''+ escapeHtml(nodeId)+'\', this)" title="Xóa"><i class="bi bi-trash3"></i></button>':'')+'</div></div></div>';
  }
  html += '</div>'; container.innerHTML = html;
}
function openEditNode(nodeId) {
  const node = _flowData[nodeId] || { text: '', buttons: [] };
  document.getElementById('fnModalNodeId').textContent = nodeId;
  document.getElementById('fnNodeId').value = nodeId;
  document.getElementById('fnNodeText').value = node.text || '';
  const container = document.getElementById('fnBtnList'); container.innerHTML = '';
  (node.buttons||[]).forEach(function(btn) { fnAddBtn(btn.label, btn.type, btn.value); });
  new bootstrap.Modal(document.getElementById('flowNodeModal')).show();
}
function fnAddBtn(label, type, value) {
  const container = document.getElementById('fnBtnList');
  const nodeIds = Object.keys(_flowData).sort(function(a,b){return a==='start'?-1:b==='start'?1:a.localeCompare(b);});
  const isNode = (type==='node');
  const nodeOptions = nodeIds.map(function(id){ return '<option value="'+escapeHtml(id)+'"'+( isNode&&value===id?' selected':'')+'>'+escapeHtml(id)+'</option>'; }).join('');
  const div = document.createElement('div'); div.className = 'fn-btn-row mb-2 p-2 rounded'; div.style.cssText = 'background:rgba(255,255,255,.03);border:1px solid var(--border-color);';
  div.innerHTML = '<div class="mb-1"><input class="form-control form-control-sm fn-btn-label" placeholder="Tên nút" value="'+escapeHtml(label||'')+'"></div><div class="d-flex gap-2 align-items-center flex-wrap"><select class="form-select form-select-sm fn-btn-type" onchange="fnToggleBtnType(this)" style="max-width:180px;flex-shrink:0;"><option value="url"'+(!isNode?' selected':'')+'>&#128279; Mở Link Web</option><option value="node"'+( isNode?' selected':'')+'>&#128172; Mở Tin nhắn Khác</option></select><input class="form-control form-control-sm fn-btn-url'+( isNode?' d-none':'')+'" style="flex:1;min-width:100px;" placeholder="https://..." value="'+escapeHtml(!isNode?(value||''): '')+'"><select class="form-select form-select-sm fn-btn-node'+(!isNode?' d-none':'')+'" style="flex:1;min-width:100px;">'+nodeOptions+'</select><button class="btn btn-sm btn-outline-danger flex-shrink-0" onclick="this.closest(\'.fn-btn-row\').remove()"><i class="bi bi-x-lg"></i></button></div>';
  container.appendChild(div);
}
function fnToggleBtnType(select) {
  const row = select.closest('.fn-btn-row'); const urlInput = row.querySelector('.fn-btn-url'); const nodeSelect = row.querySelector('.fn-btn-node');
  if (select.value==='node') { urlInput.classList.add('d-none'); nodeSelect.classList.remove('d-none'); } else { urlInput.classList.remove('d-none'); nodeSelect.classList.add('d-none'); }
}
async function doSaveNode(btn) {
  const nodeId = document.getElementById('fnNodeId').value, text = document.getElementById('fnNodeText').value;
  const buttons = [];
  document.querySelectorAll('#fnBtnList .fn-btn-row').forEach(function(row) {
    const label = row.querySelector('.fn-btn-label').value.trim(), type = row.querySelector('.fn-btn-type').value;
    const value = type==='node' ? row.querySelector('.fn-btn-node').value : row.querySelector('.fn-btn-url').value.trim();
    if (label && value) buttons.push({ label: label, type: type, value: value });
  });
  const origHtml = btn.innerHTML; btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span>Đang lưu...';
  try {
    const res = await fetch('/messages/' + encodeURIComponent(nodeId), { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ text: text, buttons: buttons }) });
    const data = await res.json();
    if (data.ok) { _flowData[nodeId] = { text: text, buttons: buttons }; renderNodeList(); bootstrap.Modal.getInstance(document.getElementById('flowNodeModal')).hide(); showToast('&#9989; Đã lưu kịch bản «' + nodeId + '»!', 'success'); }
    else { showToast('&#10060; ' + (data.error||'?'), 'error'); }
  } catch(e) { showToast('&#10060; Lỗi: ' + e.message, 'error'); }
  finally { btn.disabled = false; btn.innerHTML = origHtml; }
}
async function doDeleteNode(nodeId, btn) {
  if (!confirm('Xóa kịch bản «' + nodeId + '»?')) return;
  const origHtml = btn.innerHTML; btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span>';
  try {
    const res = await fetch('/messages/' + encodeURIComponent(nodeId) + '/delete', { method: 'POST' }); const data = await res.json();
    if (data.ok) { delete _flowData[nodeId]; renderNodeList(); showToast('&#9989; Đã xóa!', 'success'); }
    else { showToast('&#10060; ' + (data.error||'?'), 'error'); btn.disabled = false; btn.innerHTML = origHtml; }
  } catch(e) { showToast('&#10060; Lỗi: ' + e.message, 'error'); btn.disabled = false; btn.innerHTML = origHtml; }
}
function showAddNodeModal() { document.getElementById('newNodeId').value = ''; new bootstrap.Modal(document.getElementById('addNodeModal')).show(); }
async function doAddNode(btn) {
  const nodeId = document.getElementById('newNodeId').value.trim().toLowerCase();
  if (!nodeId) { showToast('&#9888;&#65039; Vui lòng nhập ID kịch bản', 'error'); return; }
  if (!/^[a-z0-9_-]+$/.test(nodeId)) { showToast('&#9888;&#65039; ID chỉ dùng chữ thường, số và _', 'error'); return; }
  if (_flowData[nodeId]) { showToast('&#9888;&#65039; Kịch bản «' + nodeId + '» đã tồn tại!', 'error'); return; }
  _flowData[nodeId] = { text: '', buttons: [] }; renderNodeList();
  bootstrap.Modal.getInstance(document.getElementById('addNodeModal')).hide();
  setTimeout(function() { openEditNode(nodeId); }, 350);
}
/* ====== SLOGAN MANAGER ====== */
let _slogans = { enabled: true, items: [] };
async function loadSlogans() {
  try { const res = await fetch('/slogans'); if (!res.ok) return; _slogans = await res.json(); document.getElementById('sloganEnabled').checked = !!_slogans.enabled; document.getElementById('sloganEnabledLabel').textContent = _slogans.enabled ? 'Bật' : 'Tắt'; renderSloganList(); }
  catch(e) { console.error('Failed to load slogans:', e); }
}
function toggleSloganEnabled(checkbox) { _slogans.enabled = checkbox.checked; document.getElementById('sloganEnabledLabel').textContent = checkbox.checked ? 'Bật' : 'Tắt'; }
function renderSloganList() {
  const container = document.getElementById('sloganList'); if (!container) return;
  if (!_slogans.items || _slogans.items.length === 0) { container.innerHTML = '<div class="empty-state py-3"><i class="bi bi-chat-quote"></i><p class="mt-2 mb-0">Chưa có slogan nào.</p></div>'; return; }
  let html = '<div class="list-group list-group-flush">';
  _slogans.items.forEach(function(item, idx) {
    const text = (item.text||'').replace(/\n/g,' ').substring(0,80);
    html += '<div class="list-group-item py-2" style="background:transparent;border-color:var(--border-color);"><div class="d-flex align-items-start gap-3"><span class="badge bg-secondary rounded-pill mt-1" style="min-width:26px;text-align:center;">'+( idx+1)+'</span><div class="flex-grow-1" style="min-width:0;"><div class="text-truncate text-light" style="font-size:.88rem;">'+escapeHtml(text)+(item.text.length>80?'&#8230;':'')+'</div><span class="text-muted" style="font-size:.75rem;"><i class="bi bi-clock me-1"></i>'+item.delay_after+'s</span></div><div class="d-flex gap-1 flex-shrink-0"><button class="btn btn-sm btn-outline-secondary" onclick="moveSloganUp('+idx+')" '+( idx===0?'disabled':'')+' title="Lên"><i class="bi bi-arrow-up"></i></button><button class="btn btn-sm btn-outline-secondary" onclick="moveSloganDown('+idx+')" '+( idx===_slogans.items.length-1?'disabled':'')+' title="Xuống"><i class="bi bi-arrow-down"></i></button><button class="btn btn-sm btn-outline-primary" onclick="openEditSlogan('+idx+')" title="Sửa"><i class="bi bi-pencil"></i></button><button class="btn btn-sm btn-outline-danger" onclick="deleteSloganItem('+idx+')" title="Xóa"><i class="bi bi-trash3"></i></button></div></div></div>';
  });
  html += '</div>'; container.innerHTML = html;
}
function showAddSloganModal() { document.getElementById('sloganModalTitle').innerHTML = '<i class="bi bi-chat-quote me-2" style="color:var(--accent);"></i>Thêm Slogan'; document.getElementById('sloganEditIndex').value = '-1'; document.getElementById('sloganText').value = ''; document.getElementById('sloganDelay').value = '1'; new bootstrap.Modal(document.getElementById('sloganModal')).show(); }
function openEditSlogan(idx) {
  const item = _slogans.items[idx]; if (!item) return;
  document.getElementById('sloganModalTitle').innerHTML = '<i class="bi bi-pencil-square me-2" style="color:var(--accent);"></i>Sửa Slogan #' + (idx+1);
  document.getElementById('sloganEditIndex').value = idx; document.getElementById('sloganText').value = item.text||''; document.getElementById('sloganDelay').value = item.delay_after!=null?item.delay_after:1;
  new bootstrap.Modal(document.getElementById('sloganModal')).show();
}
function doSaveSloganItem(btn) {
  const text = document.getElementById('sloganText').value.trim();
  if (!text) { showToast('&#9888;&#65039; Vui lòng nhập nội dung slogan', 'error'); return; }
  const delay = parseFloat(document.getElementById('sloganDelay').value)||1, idx = parseInt(document.getElementById('sloganEditIndex').value, 10);
  const item = { text: text, delay_after: Math.max(0, Math.min(30, delay)) };
  if (idx >= 0 && idx < _slogans.items.length) { _slogans.items[idx] = item; } else { _slogans.items.push(item); }
  renderSloganList(); bootstrap.Modal.getInstance(document.getElementById('sloganModal')).hide();
  showToast('&#9989; Slogan cập nhật. Nhớ nhấn «Lưu» để áp dụng!', 'success');
}
function deleteSloganItem(idx) { if (!confirm('Xóa slogan #' + (idx+1) + '?')) return; _slogans.items.splice(idx,1); renderSloganList(); }
function moveSloganUp(idx) { if (idx<=0) return; const tmp=_slogans.items[idx-1]; _slogans.items[idx-1]=_slogans.items[idx]; _slogans.items[idx]=tmp; renderSloganList(); }
function moveSloganDown(idx) { if (idx>=_slogans.items.length-1) return; const tmp=_slogans.items[idx+1]; _slogans.items[idx+1]=_slogans.items[idx]; _slogans.items[idx]=tmp; renderSloganList(); }
async function doSaveSlogans(btn) {
  const origHtml = btn.innerHTML; btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span>Đang lưu...';
  try { const res = await fetch('/slogans', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(_slogans) }); const data = await res.json(); showToast(data.ok ? '&#9989; Đã lưu Slogan!' : '&#10060; ' + (data.error||'?'), data.ok?'success':'error'); }
  catch(e) { showToast('&#10060; Lỗi: ' + e.message, 'error'); }
  finally { btn.disabled = false; btn.innerHTML = origHtml; }
}
/* ====== SCRIPT MANAGER ====== */
let _smFlow = {};
async function loadScriptData() {
  try {
    const res = await fetch('/messages');
    if (!res.ok) return;
    _smFlow = await res.json();
    renderScriptWelcome();
    renderScriptAlbumEnd();
  } catch(e) { console.error('Failed to load script data:', e); }
}
function renderScriptWelcome() {
  const node = _smFlow['start'] || { text: '', buttons: [] };
  const el = document.getElementById('sm-welcome-text');
  if (el) el.value = node.text || '';
  const container = document.getElementById('sm-welcome-buttons');
  if (!container) return;
  container.innerHTML = '';
  (node.buttons || []).forEach(function(btn) { smRenderBtn('welcome', btn.label, btn.type, btn.value); });
}
function renderScriptAlbumEnd() {
  const node = _smFlow['album_end'] || {
    text: 'Bạn đã xem xong album! 😊\nNhấn nút bên dưới để quay lại danh sách.',
    buttons: [{ label: '🔙 Quay lại danh sách Album', type: 'open_album_list', value: 'menu' }]
  };
  const el = document.getElementById('sm-end-text');
  if (el) el.value = node.text || '';
  const container = document.getElementById('sm-end-buttons');
  if (!container) return;
  container.innerHTML = '';
  (node.buttons || []).forEach(function(btn) { smRenderBtn('end', btn.label, btn.type, btn.value); });
}
function smRenderBtn(section, label, type, value) {
  const container = document.getElementById('sm-' + section + '-buttons');
  if (!container) return;
  const isOpenAlbum = type === 'open_album_list';
  const isNode = type === 'node';
  const isUrl = !isOpenAlbum && !isNode;
  const nodeOptions = Object.keys(_smFlow).map(function(id) {
    return '<option value="'+escapeHtml(id)+'"'+(isNode&&value===id?' selected':'')+'>'+escapeHtml(id)+'</option>';
  }).join('');
  const div = document.createElement('div');
  div.className = 'sm-btn-row mb-2 p-2 rounded';
  div.style.cssText = 'background:rgba(255,255,255,.03);border:1px solid var(--border-color);font-size:.82rem;';
  div.innerHTML = '<div class="d-flex gap-2 align-items-center flex-wrap">'
    + '<input class="form-control form-control-sm sm-btn-label" placeholder="Tên nút" value="'+escapeHtml(label||'')+'" style="flex:1;min-width:90px;">'
    + '<select class="form-select form-select-sm sm-btn-type" onchange="smToggleBtnType(this)" style="max-width:200px;flex-shrink:0;">'
    + '<option value="url"'+(isUrl?' selected':'')+'>🔗 Mở Link Web</option>'
    + '<option value="open_album_list"'+(isOpenAlbum?' selected':'')+'>📂 Xem Danh sách Album</option>'
    + '<option value="node"'+(isNode?' selected':'')+'>💬 Mở Kịch bản Khác</option>'
    + '</select>'
    + '<input class="form-control form-control-sm sm-btn-url'+(isUrl?'':' d-none')+'" placeholder="https://..." value="'+escapeHtml(isUrl?(value||''):'')+'" style="flex:1;min-width:100px;">'
    + (nodeOptions ? '<select class="form-select form-select-sm sm-btn-node'+(isNode?'':' d-none')+'" style="flex:1;">'+nodeOptions+'</select>' : '')
    + '<button class="btn btn-sm btn-outline-danger flex-shrink-0" onclick="this.closest(\'.sm-btn-row\').remove()"><i class="bi bi-x-lg"></i></button>'
    + '</div>';
  container.appendChild(div);
}
function smAddBtn(section) { smRenderBtn(section, '', 'url', ''); }
function smAddAlbumListBtn(section) {
  smRenderBtn(section, section === 'end' ? '🔙 Quay lại danh sách Album' : '📂 Xem Album', 'open_album_list', 'menu');
}
function smToggleBtnType(select) {
  const row = select.closest('.sm-btn-row');
  const urlInput = row.querySelector('.sm-btn-url');
  const nodeSelect = row.querySelector('.sm-btn-node');
  if (urlInput) urlInput.classList.toggle('d-none', select.value !== 'url');
  if (nodeSelect) nodeSelect.classList.toggle('d-none', select.value !== 'node');
}
function smCollectButtons(section) {
  const buttons = [];
  document.querySelectorAll('#sm-' + section + '-buttons .sm-btn-row').forEach(function(row) {
    const label = row.querySelector('.sm-btn-label').value.trim();
    const type = row.querySelector('.sm-btn-type').value;
    let value = '';
    if (type === 'url') value = (row.querySelector('.sm-btn-url') || {}).value || '';
    else if (type === 'node') value = (row.querySelector('.sm-btn-node') || {}).value || '';
    else if (type === 'open_album_list') value = 'menu';
    if (label) {
      const cleanValue = type === 'open_album_list' ? 'menu' : value.trim();
      if (cleanValue || type === 'open_album_list') {
        buttons.push({ label: label, type: type, value: cleanValue });
      }
    }
  });
  return buttons;
}
async function smSaveWelcome(btn) {
  await smSaveNode('start', document.getElementById('sm-welcome-text').value, smCollectButtons('welcome'), btn, 'Tin nhắn Chào mừng');
}
async function smSaveAlbumEnd(btn) {
  await smSaveNode('album_end', document.getElementById('sm-end-text').value, smCollectButtons('end'), btn, 'Tin nhắn Kết thúc Album');
}
async function smSaveNode(nodeId, text, buttons, btn, label) {
  const origHtml = btn.innerHTML;
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span>Đang lưu...';
  try {
    const res = await fetch('/messages/' + encodeURIComponent(nodeId), {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ text: text, buttons: buttons })
    });
    const data = await res.json();
    if (data.ok) {
      _smFlow[nodeId] = { text: text, buttons: buttons };
      showToast('&#9989; Đã lưu ' + (label || nodeId) + '!', 'success');
    } else { showToast('&#10060; ' + (data.error || '?'), 'error'); }
  } catch(e) { showToast('&#10060; Lỗi: ' + e.message, 'error'); }
  finally { btn.disabled = false; btn.innerHTML = origHtml; }
}
/* ====== INIT ====== */
window.addEventListener('DOMContentLoaded', function() {
  const hash = window.location.hash.replace('#','')||'dashboard';
  const validSections = ['dashboard','bots','analytics','ids','albums','script','config','system'];
  showSection(validSections.includes(hash) ? hash : 'dashboard');
  const activeAlbumId = '{{ active_album }}';
  if (activeAlbumId) {
    setTimeout(function() {
      const el = document.getElementById('album-' + activeAlbumId);
      if (el) { showSection('albums'); el.scrollIntoView({behavior:'smooth',block:'start'}); const posts = el.querySelectorAll('.post-item'); if (posts.length===0) toggleAddPost(activeAlbumId); }
    }, 100);
  }
});
