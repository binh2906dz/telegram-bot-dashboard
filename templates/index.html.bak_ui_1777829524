          {% else %}
            <li class="list-group-item text-center text-muted" style="background:#1a1d23; border-color:#2a2d35;">Chưa có danh mục nào.</li>
          {% endif %}
        </ul>
      </div>
    </div>
  </div>
</div>

<!-- Create Album Modal -->
<div class="modal fade" id="createAlbumModal" tabindex="-1">
