<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Admin Dashboard 🔥</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <style>
    :root {
      --accent: #ff5e00; --accent-light: #ff8533;
      --card-bg: #1a1d23; --sidebar-bg: #13151a;
      --sidebar-width: 240px; --topbar-height: 56px;
      --body-bg: #0f1117; --border-color: #2a2d35;
    }
    *, *::before, *::after { box-sizing: border-box; }
    html, body { height: 100%; margin: 0; }
    body { background: var(--body-bg); color: #e0e0e0; font-family: 'Segoe UI', system-ui, sans-serif; display: flex; flex-direction: column; }
    .topbar { height: var(--topbar-height); background: var(--sidebar-bg); border-bottom: 1px solid var(--border-color); display: flex; align-items: center; padding: 0 16px; gap: 12px; position: fixed; top: 0; left: 0; right: 0; z-index: 1050; }
    .topbar .brand { font-size: 1.1rem; font-weight: 700; color: var(--accent); white-space: nowrap; margin-right: auto; }
    .sidebar-toggle { background: none; border: none; color: #ccc; font-size: 1.4rem; cursor: pointer; padding: 2px 6px; border-radius: 6px; }
    .sidebar-toggle:hover { background: rgba(255,255,255,.06); }
    .layout { display: flex; flex: 1; margin-top: var(--topbar-height); overflow: hidden; }
    .sidebar { width: var(--sidebar-width); min-width: var(--sidebar-width); background: var(--sidebar-bg); border-right: 1px solid var(--border-color); display: flex; flex-direction: column; height: calc(100vh - var(--topbar-height)); position: fixed; top: var(--topbar-height); left: 0; z-index: 1040; transition: transform .25s ease; overflow-y: auto; }
    .sidebar.collapsed { transform: translateX(calc(-1 * var(--sidebar-width))); }
    .nav-section-label { font-size: .68rem; text-transform: uppercase; color: #555; font-weight: 700; letter-spacing: 1px; padding: 16px 16px 6px; }
    .nav-item { display: flex; align-items: center; gap: 10px; padding: 10px 16px; cursor: pointer; font-size: .9rem; color: #aaa; border-left: 3px solid transparent; user-select: none; transition: background .15s, color .15s; }
    .nav-item:hover { background: rgba(255,255,255,.04); color: #e0e0e0; }
    .nav-item.active { color: var(--accent); background: rgba(255,94,0,.08); border-left-color: var(--accent); }
    .nav-item i { font-size: 1rem; width: 20px; text-align: center; }
    .sidebar-footer { margin-top: auto; padding: 12px 16px; border-top: 1px solid var(--border-color); }
    .main-content { flex: 1; margin-left: var(--sidebar-width); transition: margin-left .25s ease; overflow-y: auto; height: calc(100vh - var(--topbar-height)); padding: 24px 20px; }
    .main-content.expanded { margin-left: 0; }
    .section-page { display: none; }
    .section-page.active { display: block; }
    .page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; flex-wrap: wrap; gap: 10px; }
    .page-title { font-size: 1.2rem; font-weight: 700; color: #fff; }
    .page-title i { color: var(--accent); margin-right: 8px; }
    .stat-card { background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 14px; padding: 18px 20px; display: flex; align-items: center; gap: 14px; transition: transform .15s, box-shadow .15s; }
    .stat-card:hover { transform: translateY(-2px); box-shadow: 0 6px 24px rgba(0,0,0,.4); }
    .stat-icon { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; flex-shrink: 0; }
    .stat-icon.orange { background: rgba(255,94,0,.15); color: var(--accent); }
    .stat-icon.blue   { background: rgba(0,120,255,.15); color: #4d9fff; }
    .stat-icon.green  { background: rgba(0,200,83,.15);  color: #00c853; }
    .stat-icon.red    { background: rgba(244,67,54,.15);  color: #f44336; }
    .stat-icon.purple { background: rgba(156,39,176,.15); color: #ce93d8; }
    .stat-icon.yellow { background: rgba(255,193,7,.15);  color: #ffc107; }
    .stat-value { font-size: 1.7rem; font-weight: 700; line-height: 1.1; }
    .stat-label { font-size: .76rem; color: #888; margin-top: 2px; }
    .dash-card { background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 14px; overflow: hidden; }
    .dash-card-header { padding: 14px 18px; background: rgba(255,255,255,.03); border-bottom: 1px solid var(--border-color); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; }
    .dash-card-title { font-size: .9rem; font-weight: 600; color: #ccc; text-transform: uppercase; letter-spacing: .6px; }
    .dash-card-body { padding: 16px 18px; }
    .btn-accent { background: var(--accent); color: #fff; border: none; font-weight: 600; }
    .btn-accent:hover { background: var(--accent-light); color: #fff; }
    .data-table th { font-size: .75rem; text-transform: uppercase; color: #777; font-weight: 600; }
    .data-table td { font-size: .85rem; vertical-align: middle; }
    .status-badge { display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 20px; font-size: .72rem; font-weight: 600; }
    .status-active  { background: rgba(0,200,83,.15); color: #00c853; }
    .status-blocked { background: rgba(244,67,54,.15); color: #f44336; }
    .status-invalid { background: rgba(255,152,0,.15); color: #ff9800; }
    .status-unknown { background: rgba(150,150,150,.15); color: #999; }
    .status-live  { color: #00c853; font-weight: 700; font-size: .82rem; }
    .status-ban   { color: #f44336; font-weight: 700; font-size: .82rem; }
    .status-error { color: #ff9800; font-weight: 700; font-size: .82rem; }
    .form-control, .form-control:focus, .form-select, .form-select:focus { background: #0f1117; border-color: var(--border-color); color: #e0e0e0; }
    .form-control:focus, .form-select:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(255,94,0,.12); }
    textarea.form-control { resize: vertical; }
    .modal-content { background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 16px; }
    .modal-header { border-bottom: 1px solid var(--border-color); }
    .modal-footer { border-top: 1px solid var(--border-color); }
    .drop-zone { border: 2px dashed var(--border-color); border-radius: 10px; padding: 24px; text-align: center; cursor: pointer; transition: border-color .2s, background .2s; background: rgba(255,255,255,.02); position: relative; }
    .drop-zone:hover, .drop-zone.dragover { border-color: var(--accent); background: rgba(255,94,0,.05); }
    .preview-grid { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
    .preview-grid img { width: 70px; height: 70px; object-fit: cover; border-radius: 6px; }
    .photo-thumb { width: 80px; height: 80px; object-fit: cover; border-radius: 8px; border: 1px solid var(--border-color); cursor: pointer; transition: transform .15s; }
    .photo-thumb:hover { transform: scale(1.05); }
    .album-card { background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 14px; overflow: hidden; transition: box-shadow .15s; margin-bottom: 16px; }
    .album-card:hover { box-shadow: 0 4px 20px rgba(0,0,0,.5); }
    .album-card.active-album { border-color: var(--accent); }
    .bot-token-mask { font-family: monospace; letter-spacing: .5px; color: #aaa; font-size: .78rem; }
    .progress { background: rgba(255,255,255,.06); height: 8px; }
    .empty-state { text-align: center; padding: 40px 20px; color: #555; }
    .empty-state i { font-size: 2.5rem; display: block; margin-bottom: 12px; }
    .config-tabs .nav-link { color: #aaa; border: none; border-bottom: 2px solid transparent; background: none; padding: 10px 18px; font-size: .88rem; font-weight: 500; border-radius: 0; }
    .config-tabs .nav-link.active { color: var(--accent); border-bottom-color: var(--accent); }
    .config-tabs .nav-link:hover { color: #e0e0e0; background: rgba(255,255,255,.03); }
    .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.5); z-index: 1039; }
    .sidebar-overlay.show { display: block; }
    @media (max-width: 768px) {
      .sidebar { transform: translateX(calc(-1 * var(--sidebar-width))); }
      .sidebar.mobile-open { transform: translateX(0); }
      .main-content { margin-left: 0; }
    }
    @media (min-width: 769px) {
      .sidebar.collapsed { transform: translateX(calc(-1 * var(--sidebar-width))); }
      .main-content.expanded { margin-left: 0; }
    }
    #lightbox { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.92); z-index: 9999; align-items: center; justify-content: center; }
    #lightbox.show { display: flex; }
    #lightbox img { max-width: 92vw; max-height: 90vh; border-radius: 8px; }
    #lightbox .close-lb { position: absolute; top: 18px; right: 22px; font-size: 2rem; color: #fff; cursor: pointer; }
  </style>
</head>
<body>

<!-- TOPBAR -->
<div class="topbar">
  <button class="sidebar-toggle" onclick="toggleSidebar()"><i class="bi bi-list"></i></button>
  <span class="brand"><i class="bi bi-fire me-1"></i>DASHBOARD VIP</span>
  <span class="badge bg-success rounded-pill d-none d-sm-inline-flex"><i class="bi bi-circle-fill me-1" style="font-size:.5rem;"></i>Online</span>
  <span class="badge bg-secondary rounded-pill ms-1"><i class="bi bi-person-fill me-1"></i>{{ username }}{% if role == 'owner' %}<span class="ms-1 text-warning">&#128081;</span>{% endif %}</span>
  <a href="/logout" class="btn btn-sm btn-outline-danger ms-2"><i class="bi bi-box-arrow-right me-1"></i><span class="d-none d-sm-inline">Đăng xuất</span></a>
</div>

<div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

<div class="layout">
  <!-- Sidebar -->
  <nav class="sidebar" id="sidebar">
    <div style="padding-top:8px;"></div>
    <div class="nav-section-label">Tổng quan</div>
    <div class="nav-item active" id="nav-dashboard" onclick="showSection('dashboard')"><i class="bi bi-speedometer2"></i> Dashboard</div>
    <div class="nav-section-label">Quản lý</div>
    <div class="nav-item" id="nav-bots" onclick="showSection('bots')"><i class="bi bi-robot"></i> Quản lý Bot</div>
    <div class="nav-item" id="nav-analytics" onclick="showSection('analytics')"><i class="bi bi-bar-chart-line-fill"></i> Master Analytics</div>
    <div class="nav-item" id="nav-ids" onclick="showSection('ids')"><i class="bi bi-people-fill"></i> Quản lý ID</div>
    <div class="nav-item" id="nav-albums" onclick="showSection('albums')"><i class="bi bi-collection"></i> Albums</div>
    <div class="nav-item" id="nav-script" onclick="showSection('script')"><i class="bi bi-diagram-3"></i> Kịch bản &amp; Album</div>
    <div class="nav-section-label">Cài đặt</div>
    <div class="nav-item" id="nav-config" onclick="showSection('config')"><i class="bi bi-gear-fill"></i> Cấu hình Bot</div>
    <div class="nav-section-label">Hệ thống</div>
    <div class="nav-item" id="nav-system" onclick="showSection('system')"><i class="bi bi-shield-fill"></i> Backup &amp; Hệ thống</div>
    <div class="sidebar-footer"><div style="font-size:.72rem; color:#555;"><i class="bi bi-database me-1"></i>SQLite · Cloudinary · APScheduler</div></div>
  </nav>

  <!-- Main Content -->
  <main class="main-content" id="mainContent">

    <!-- DASHBOARD SECTION -->
    <div class="section-page active" id="section-dashboard">
      <div class="page-header">
        <span class="page-title"><i class="bi bi-speedometer2"></i>Dashboard</span>
        <span class="text-muted" style="font-size:.8rem;"><i class="bi bi-clock me-1"></i><span id="dashClock"></span></span>
      </div>
      <div class="row g-3 mb-4">
        <div class="col-6 col-md-4 col-lg-2">
          <div class="stat-card"><div class="stat-icon orange"><i class="bi bi-robot"></i></div><div><div class="stat-value">{{ bots|length }}</div><div class="stat-label">Bot đang có</div></div></div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
          <div class="stat-card"><div class="stat-icon blue"><i class="bi bi-people-fill"></i></div><div><div class="stat-value">{{ subs|length }}</div><div class="stat-label">Subscribers</div></div></div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
          <div class="stat-card"><div class="stat-icon green"><i class="bi bi-person-check-fill"></i></div><div><div class="stat-value">{{ id_stats.active }}</div><div class="stat-label">ID Active</div></div></div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
          <div class="stat-card"><div class="stat-icon red"><i class="bi bi-person-x-fill"></i></div><div><div class="stat-value">{{ id_stats.blocked + id_stats.invalid }}</div><div class="stat-label">Blocked/Invalid</div></div></div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
          <div class="stat-card"><div class="stat-icon purple"><i class="bi bi-images"></i></div><div><div class="stat-value">{{ albums|length }}</div><div class="stat-label">Albums</div></div></div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
          <div class="stat-card"><div class="stat-icon yellow"><i class="bi bi-file-earmark-image"></i></div><div><div class="stat-value">{{ total_posts }}</div><div class="stat-label">Bài viết</div></div></div>
        </div>
      </div>
      <div class="row g-3">
        <div class="col-12 col-md-6">
          <div class="dash-card">
            <div class="dash-card-header"><span class="dash-card-title"><i class="bi bi-lightning-fill me-2" style="color:var(--accent);"></i>Hành động nhanh</span></div>
            <div class="dash-card-body d-flex flex-wrap gap-2">
              <button class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#broadcastModal"><i class="bi bi-megaphone-fill me-1"></i>Gửi thông báo</button>
              <button class="btn btn-sm btn-accent" onclick="showSection('ids')"><i class="bi bi-cloud-upload me-1"></i>Upload IDs</button>
              <button class="btn btn-sm btn-outline-info" onclick="showSection('albums')"><i class="bi bi-folder-plus me-1"></i>Tạo Album</button>
              {% if role == 'owner' %}<a href="/backup/download" class="btn btn-sm btn-outline-warning"><i class="bi bi-download me-1"></i>Tải Backup</a>{% endif %}
            </div>
          </div>
        </div>
        <div class="col-12 col-md-6">
          <div class="dash-card">
            <div class="dash-card-header"><span class="dash-card-title"><i class="bi bi-bar-chart-fill me-2" style="color:#4d9fff;"></i>Thống kê ID</span></div>
            <div class="dash-card-body">
              <div class="d-flex flex-wrap gap-3 mb-2">
                <div><div style="font-size:.8rem;color:#888;">Tổng</div><div style="font-size:1.3rem;font-weight:700;">{{ id_stats.total }}</div></div>
                <div><div style="font-size:.8rem;color:#888;">Chưa test</div><div style="font-size:1.3rem;font-weight:700;color:#aaa;">{{ id_stats.unknown }}</div></div>
                <div><div style="font-size:.8rem;color:#888;">Active</div><div style="font-size:1.3rem;font-weight:700;color:#00c853;">{{ id_stats.active }}</div></div>
                <div><div style="font-size:.8rem;color:#888;">Blocked</div><div style="font-size:1.3rem;font-weight:700;color:#f44336;">{{ id_stats.blocked }}</div></div>
                <div><div style="font-size:.8rem;color:#888;">Invalid</div><div style="font-size:1.3rem;font-weight:700;color:#ff9800;">{{ id_stats.invalid }}</div></div>
              </div>
              {% if id_stats.total > 0 %}
              <div class="progress" style="height:10px;border-radius:10px;">
                <div class="progress-bar bg-success" style="width:{{ (id_stats.active / id_stats.total * 100)|round(1) }}%"></div>
                <div class="progress-bar bg-danger"  style="width:{{ (id_stats.blocked / id_stats.total * 100)|round(1) }}%"></div>
                <div class="progress-bar bg-warning" style="width:{{ (id_stats.invalid / id_stats.total * 100)|round(1) }}%"></div>
              </div>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- BOT MANAGEMENT SECTION -->
    <div class="section-page" id="section-bots">
      <div class="page-header">
        <span class="page-title"><i class="bi bi-robot"></i>Quản lý Bot</span>
        {% if role == 'owner' %}
        <div class="d-flex gap-2">
          <button class="btn btn-sm btn-outline-info" onclick="loadBotHealth(this)"><i class="bi bi-activity me-1"></i>Kiểm tra trạng thái</button>
          <button class="btn btn-sm btn-accent" data-bs-toggle="modal" data-bs-target="#addBotModal"><i class="bi bi-plus-lg me-1"></i>Thêm Bot</button>
        </div>
        {% endif %}
      </div>
      <div class="dash-card">
        <div class="dash-card-body p-0">
          {% if bots %}
          <div class="table-responsive">
            <table class="table table-dark table-borderless data-table mb-0" id="botsTable">
              <thead><tr><th class="ps-3">Tên Bot</th><th>Token</th><th>Admin ID</th><th>Trạng thái</th><th>Auto-Responder</th><th>Subscribers</th><th>▶ Start</th><th>📤 Gửi</th><th>🖱 Click</th><th>💬 Phản hồi</th><th style="width:60px;"></th></tr></thead>
              <tbody>
                {% for bot in bots %}
                <tr id="bot-row-{{ bot.id }}">
                  <td class="ps-3"><i class="bi bi-robot me-2" style="color:var(--accent);"></i>{{ bot.name }}</td>
                  <td>
                    <span class="bot-token-mask" id="bot-token-mask-{{ bot.id }}">{{ bot.token[:4] }}&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;</span>
                    <span id="bot-token-full-{{ bot.id }}" class="font-monospace text-warning" style="font-size:.75rem;display:none;word-break:break-all;"></span>
                    {% if role == 'owner' %}<button class="btn btn-sm btn-outline-secondary ms-1" style="padding:1px 6px;font-size:.7rem;" onclick="toggleTokenView('{{ bot.id }}', this)" title="Xem/ẩn token"><i class="bi bi-eye"></i></button>{% endif %}
                  </td>
                  <td>{{ bot.admin_id if bot.admin_id else '&#8212;' }}</td>
                  <td id="bot-status-{{ bot.id }}"><span class="text-muted" style="font-size:.8rem;">&#8212;</span></td>
                  <td>
                    {% if role == 'owner' %}
                    <div class="form-check form-switch mb-0" style="min-width:52px;">
                      <input class="form-check-input" type="checkbox" role="switch"
                             id="ar-toggle-{{ bot.id }}"
                             {% if bot.get('auto_responder', True) %}checked{% endif %}
                             onchange="toggleAutoResponder('{{ bot.id }}', this)">
                      <label class="form-check-label" for="ar-toggle-{{ bot.id }}" style="font-size:.78rem;color:#aaa;">
                        <span id="ar-label-{{ bot.id }}">{{ 'Bật' if bot.get('auto_responder', True) else 'Tắt' }}</span>
                      </label>
                    </div>
                    {% else %}
                    <span style="font-size:.8rem;color:{{ '#00c853' if bot.get('auto_responder', True) else '#888' }};">
                      {{ 'Bật' if bot.get('auto_responder', True) else 'Tắt' }}
                    </span>
                    {% endif %}
                  </td>
                  <td id="bot-subs-{{ bot.id }}">&#8212;</td>
                  <td id="bot-starts-{{ bot.id }}">&#8212;</td>
                  <td id="bot-msgs-{{ bot.id }}">&#8212;</td>
                  <td id="bot-interactions-{{ bot.id }}">&#8212;</td>
                  <td id="bot-replies-{{ bot.id }}">&#8212;</td>
                  <td>{% if role == 'owner' %}<button class="btn btn-sm btn-outline-danger" onclick="doDeleteBot('{{ bot.id }}', '{{ bot.name }}', this)"><i class="bi bi-trash3"></i></button>{% endif %}</td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
          {% else %}
          <div class="empty-state py-5"><i class="bi bi-robot" style="font-size:2.5rem;color:var(--accent);"></i><p class="mt-2">Chưa có bot nào.</p></div>
          {% endif %}
        </div>
        <div class="dash-card-body pt-2" style="border-top:1px solid var(--border-color);">
          <div style="font-size:.76rem;color:#666;"><i class="bi bi-info-circle me-1"></i>Bot mới thêm vào sẽ <strong>tự động bắt đầu polling</strong> trong vòng 30 giây, không cần khởi động lại server.</div>
        </div>
      </div>
    </div>

    <!-- MASTER ANALYTICS SECTION -->
    <div class="section-page" id="section-analytics">
      <div class="page-header">
        <span class="page-title"><i class="bi bi-bar-chart-line-fill"></i>Master Analytics</span>
        <button class="btn btn-sm btn-outline-info" onclick="loadAnalytics(this)"><i class="bi bi-arrow-clockwise me-1"></i>Làm mới</button>
      </div>
      <!-- Aggregated Stats -->
      <div class="row g-3 mb-4" id="analyticsAggregated">
        <div class="col-6 col-md-3">
          <div class="stat-card"><div class="stat-icon orange"><i class="bi bi-play-circle-fill"></i></div><div><div class="stat-value" id="agg-starts">&#8212;</div><div class="stat-label">Tổng /start</div></div></div>
        </div>
        <div class="col-6 col-md-3">
          <div class="stat-card"><div class="stat-icon blue"><i class="bi bi-send-fill"></i></div><div><div class="stat-value" id="agg-sent">&#8212;</div><div class="stat-label">Tổng tin đã gửi</div></div></div>
        </div>
        <div class="col-6 col-md-3">
          <div class="stat-card"><div class="stat-icon green"><i class="bi bi-hand-index-thumb-fill"></i></div><div><div class="stat-value" id="agg-interactions">&#8212;</div><div class="stat-label">Tổng tương tác</div></div></div>
        </div>
        <div class="col-6 col-md-3">
          <div class="stat-card"><div class="stat-icon purple"><i class="bi bi-chat-dots-fill"></i></div><div><div class="stat-value" id="agg-replies">&#8212;</div><div class="stat-label">Tổng phản hồi</div></div></div>
        </div>
      </div>
      <!-- Per-Bot Performance Table -->
      <div class="dash-card">
        <div class="dash-card-header"><span class="dash-card-title"><i class="bi bi-table me-2" style="color:var(--accent);"></i>Hiệu suất từng Bot</span></div>
        <div class="dash-card-body p-0">
          <div class="table-responsive">
            <table class="table table-dark table-borderless data-table mb-0" id="analyticsTable">
              <thead>
                <tr>
                  <th class="ps-3">Tên Bot</th>
                  <th class="text-center">▶ /start</th>
                  <th class="text-center">📤 Đã gửi</th>
                  <th class="text-center">🖱 Tương tác</th>
                  <th class="text-center">💬 Phản hồi</th>
                </tr>
              </thead>
              <tbody id="analyticsTableBody">
                <tr><td colspan="5" class="text-center text-muted py-4"><i class="bi bi-arrow-clockwise me-1"></i>Nhấn "Làm mới" để tải dữ liệu...</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
      <div class="mt-2" style="font-size:.76rem;color:#666;">
        <i class="bi bi-info-circle me-1"></i>
        <em>Lưu ý: Telegram không thông báo cho bot khi người dùng click vào nút URL. "Tương tác" đếm các lần người dùng nhấn nút inline (callback buttons) do bot gửi.</em>
      </div>
    </div>

    <!-- ID MANAGEMENT SECTION -->
    <div class="section-page" id="section-ids">
      <div class="page-header"><span class="page-title"><i class="bi bi-people-fill"></i>Quản lý ID Telegram</span></div>
      <div class="row g-3 mb-4">
        <div class="col-6 col-md-3"><div class="stat-card"><div class="stat-icon blue"><i class="bi bi-database"></i></div><div><div class="stat-value" id="idStat-total">{{ id_stats.total }}</div><div class="stat-label">Tổng ID</div></div></div></div>
        <div class="col-6 col-md-3"><div class="stat-card"><div class="stat-icon green"><i class="bi bi-check-circle-fill"></i></div><div><div class="stat-value" id="idStat-active">{{ id_stats.active }}</div><div class="stat-label">Active</div></div></div></div>
        <div class="col-6 col-md-3"><div class="stat-card"><div class="stat-icon red"><i class="bi bi-slash-circle-fill"></i></div><div><div class="stat-value" id="idStat-blocked">{{ id_stats.blocked }}</div><div class="stat-label">Blocked</div></div></div></div>
        <div class="col-6 col-md-3"><div class="stat-card"><div class="stat-icon yellow"><i class="bi bi-x-circle-fill"></i></div><div><div class="stat-value" id="idStat-invalid">{{ id_stats.invalid }}</div><div class="stat-label">Invalid</div></div></div></div>
      </div>
      <div class="row g-3">
        <div class="col-12 col-lg-4">
          <div class="dash-card mb-3">
            <div class="dash-card-header"><span class="dash-card-title"><i class="bi bi-cloud-upload me-2"></i>Upload ID</span></div>
            <div class="dash-card-body">
              <p style="font-size:.82rem;color:#aaa;">Tải lên file <code>.txt</code> hoặc <code>.csv</code> chứa Telegram User IDs (mỗi dòng một ID).</p>
              <div class="drop-zone" id="idDropZone" onclick="document.getElementById('idFileInput').click()"
                   ondragover="event.preventDefault();this.classList.add('dragover')"
                   ondragleave="this.classList.remove('dragover')"
                   ondrop="handleIdFileDrop(event)">
                <input type="file" id="idFileInput" accept=".txt,.csv" style="display:none" onchange="handleIdFileSelect(event)">
                <i class="bi bi-file-earmark-text fs-2 d-block mb-2 text-muted"></i>
                <span class="text-muted" style="font-size:.85rem;">Click hoặc kéo thả file vào đây</span>
                <div id="idFileName" class="mt-2" style="font-size:.8rem;color:var(--accent);display:none;"></div>
              </div>
              <button class="btn btn-accent btn-sm w-100 mt-3" id="btnUploadIds" onclick="doUploadIds(this)" disabled>
                <i class="bi bi-upload me-1"></i>Tải lên &amp; Phân tích
              </button>
            </div>
          </div>
          <div class="dash-card">
            <div class="dash-card-header"><span class="dash-card-title"><i class="bi bi-megaphone-fill me-2" style="color:#00c853;"></i>Broadcast to IDs</span></div>
            <div class="dash-card-body">
              <p style="font-size:.82rem;color:#aaa;">Gửi tới tất cả ID (unknown + active). <strong>Tất cả bot</strong> sẽ cùng gửi. Bot tự phân loại kết quả.</p>
              <textarea id="idBroadcastMessage" class="form-control mb-2" rows="3" placeholder="Nhập nội dung tin nhắn..."></textarea>
              <div class="mb-2">
                <select id="idBroadcastMediaType" class="form-select form-select-sm" onchange="toggleIdBroadcastMedia(this.value)">
                  <option value="none">Chỉ text</option>
                  <option value="image">&#128247; Hình ảnh</option>
                  <option value="video">&#127916; Video</option>
                </select>
              </div>
              <div id="idBroadcastMediaUrlRow" class="mb-2" style="display:none;">
                <input type="file" id="idBroadcastMediaFile" class="form-control form-control-sm mb-1" accept="image/*,video/*" placeholder="Tải lên file ảnh/video...">
                <input type="url" id="idBroadcastMediaUrl" class="form-control form-control-sm" placeholder="Hoặc nhập URL ảnh/video...">
                <div class="form-text text-muted" style="font-size:.72rem;">Tải lên file sẽ được ưu tiên hơn URL.</div>
              </div>
              <div class="mb-2">
                <div id="idBroadcastBtnList" class="mb-1"></div>
                <button type="button" class="btn btn-xs btn-outline-secondary" style="font-size:.76rem;padding:2px 8px;" onclick="idBroadcastAddBtn()"><i class="bi bi-plus-lg me-1"></i>Thêm nút Inline</button>
              </div>
              <button class="btn btn-success btn-sm w-100" id="btnIdBroadcast" onclick="doIdBroadcast(this)">
                <i class="bi bi-send-fill me-1"></i>Bắt đầu Broadcast
              </button>
              <div id="broadcastProgress" class="mt-3" style="display:none;">
                <div class="d-flex justify-content-between mb-1" style="font-size:.78rem;"><span id="bpLabel">Đang gửi...</span><span id="bpPercent">0%</span></div>
                <div class="progress mb-2"><div class="progress-bar progress-bar-striped progress-bar-animated bg-success" id="bpBar" style="width:0%"></div></div>
                <div class="d-flex gap-3 flex-wrap mb-2" style="font-size:.76rem;color:#aaa;">
                  <span>&#9989; Active: <strong id="bpActive">0</strong></span>
                  <span>&#128683; Blocked: <strong id="bpBlocked">0</strong></span>
                  <span>&#10060; Invalid: <strong id="bpInvalid">0</strong></span>
                </div>
                <div id="bpBotResults" style="display:none;">
                  <div style="font-size:.76rem;font-weight:600;color:#aaa;margin-bottom:4px;"><i class="bi bi-robot me-1"></i>Kết quả từng Bot:</div>
                  <div id="bpBotResultsTable"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-12 col-lg-8">
          <div class="dash-card">
            <div class="dash-card-header">
              <span class="dash-card-title"><i class="bi bi-list-ul me-2"></i>Danh sách ID</span>
              <div class="d-flex gap-2 align-items-center flex-wrap">
                <select class="form-select form-select-sm" id="idStatusFilter" onchange="loadIdList(1)" style="width:auto;">
                  <option value="">Tất cả</option><option value="unknown">Unknown</option><option value="active">Active</option><option value="blocked">Blocked</option><option value="invalid">Invalid</option>
                </select>
                <button class="btn btn-sm btn-outline-secondary" onclick="loadIdList(1)"><i class="bi bi-arrow-clockwise"></i></button>
                {% if role == 'owner' %}
                <div class="dropdown">
                  <button class="btn btn-sm btn-outline-danger dropdown-toggle" data-bs-toggle="dropdown"><i class="bi bi-trash3"></i></button>
                  <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                    <li><button class="dropdown-item text-danger" onclick="doClearIds('')">Xóa tất cả</button></li>
                    <li><button class="dropdown-item" onclick="doClearIds('blocked')">Xóa Blocked</button></li>
                    <li><button class="dropdown-item" onclick="doClearIds('invalid')">Xóa Invalid</button></li>
                  </ul>
                </div>
                {% endif %}
              </div>
            </div>
            <div class="dash-card-body p-0">
              <div id="idListContainer"><div class="empty-state py-4"><i class="bi bi-people"></i><p>Nhấn làm mới để tải danh sách</p></div></div>
              <div class="d-flex justify-content-between align-items-center px-3 py-2" style="border-top:1px solid var(--border-color);">
                <span id="idPaginationInfo" style="font-size:.78rem;color:#888;"></span>
                <div class="d-flex gap-1" id="idPaginationBtns"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ALBUMS SECTION -->
    <div class="section-page" id="section-albums">
      <div class="page-header">
        <span class="page-title"><i class="bi bi-collection"></i>Albums</span>
        <button class="btn btn-sm btn-accent" data-bs-toggle="modal" data-bs-target="#createAlbumModal"><i class="bi bi-plus-lg me-1"></i>Tạo Album mới</button>
        <button class="btn btn-sm btn-outline-info ms-2" data-bs-toggle="modal" data-bs-target="#categoryModal"><i class="bi bi-tags me-1"></i>Quản lý Danh mục</button>
      </div>
      {% if albums %}
        {% for album_id, album in albums.items() %}
        <div class="album-card {% if active_album == album_id %}active-album{% endif %}" id="album-{{ album_id }}">
          <div style="padding:14px 18px;background:rgba(255,255,255,.03);border-bottom:1px solid var(--border-color);display:flex;align-items:center;flex-wrap:wrap;gap:10px;">
            <div class="flex-grow-1">
              <div style="font-weight:600;font-size:.98rem;"><i class="bi bi-folder2-open me-2" style="color:var(--accent);"></i>{{ album.title if album.title else album_id }}{% if album.category_id %}
              {% set cat_name = namespace(value='') %}
              {% for c in categories %}{% if c.id == album.category_id %}{% set cat_name.value = c.name %}{% endif %}{% endfor %}
              <span class="badge ms-2" style="background:rgba(77,159,255,.15);color:#4d9fff;border:1px solid #4d9fff33;"><i class="bi bi-tag-fill me-1"></i>{{ cat_name.value }}</span>
              {% endif %}</div>
              {% if album.description %}<div style="font-size:.8rem;color:#777;margin-top:2px;">{{ album.description }}</div>{% endif %}
            </div>
            <span class="badge" style="background:rgba(255,94,0,.2);color:var(--accent);border-radius:20px;padding:2px 10px;font-size:.75rem;font-weight:600;">{{ album.posts|length if album.posts else 0 }} bài</span>
            <button class="btn btn-sm btn-success" onclick="toggleAddPost('{{ album_id }}')"><i class="bi bi-plus-lg"></i> Thêm bài</button>
            {% if role == 'owner' %}
            <form action="/albums/{{ album_id }}/delete" method="post" class="d-inline" onsubmit="return confirm('Xóa album ?')">
              <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash3"></i></button>
            </form>
            {% endif %}
          </div>
          <div id="add-post-panel-{{ album_id }}" style="display:none;padding:16px 18px;background:rgba(255,94,0,.05);border-bottom:1px solid var(--border-color);">
            <form action="/albums/{{ album_id }}/posts" method="post" enctype="multipart/form-data" onsubmit="showSpinner(this)">
              <div class="mb-2"><textarea name="caption" class="form-control" rows="3" placeholder="Caption / Nội dung bài viết..."></textarea></div>
              <div class="mb-2 position-relative drop-zone" id="dz-{{ album_id }}" onclick="document.getElementById('fi-{{ album_id }}').click()"
                   ondragover="event.preventDefault();this.classList.add('dragover')"
                   ondragleave="this.classList.remove('dragover')"
                   ondrop="handleDrop(event,'{{ album_id }}')">
                <input type="file" name="media" id="fi-{{ album_id }}" multiple accept="image/*,video/*" style="display:none" onchange="previewMedia(event,'{{ album_id }}')">
                <i class="bi bi-cloud-arrow-up fs-3 d-block mb-1 text-muted"></i>
                <span class="text-muted" style="font-size:.85rem;">Click hoặc kéo thả ảnh/video vào đây</span>
              </div>
              <div class="preview-grid" id="preview-{{ album_id }}"></div>
              <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-accent btn-sm"><span class="spinner-border spinner-border-sm me-1 upload-spinner" role="status" style="display:none;"></span><i class="bi bi-upload me-1"></i>Đăng bài</button>
                <button type="button" class="btn btn-secondary btn-sm" onclick="toggleAddPost('{{ album_id }}')">Hủy</button>
              </div>
            </form>
          </div>
          <div class="p-3">
            {% set posts = album.posts if album.posts else [] %}
            {% if posts %}
              {% for post in posts %}
              <div class="mb-2" style="border:1px solid var(--border-color);border-radius:10px;padding:14px;background:rgba(255,255,255,.02);">
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <div style="font-size:.9rem;color:#ccc;flex:1;margin-right:8px;white-space:pre-wrap;word-break:break-word;">
                    {% if post.caption %}{{ post.caption }}{% else %}<span class="text-muted fst-italic" style="font-size:.8rem;">(Không có caption)</span>{% endif %}
                  </div>
                  {% if role == 'owner' %}
                  <form action="/albums/{{ album_id }}/posts/{{ post.id }}/delete" method="post" onsubmit="return confirm('Xóa bài viết này?')">
                    <button type="submit" class="btn btn-sm btn-outline-danger" style="padding:2px 8px;"><i class="bi bi-x-lg"></i></button>
                  </form>
                  {% endif %}
                </div>
                <div class="d-flex flex-wrap gap-2">
                  {% for photo in post.photos %}
                    {% if photo.get('type') == 'video' %}
                    <a href="{{ photo.url }}" target="_blank" rel="noopener" class="d-flex align-items-center justify-content-center photo-thumb text-decoration-none" style="background:#0f1117;" title="Xem video" aria-label="Xem video trong tab mới">
                      <i class="bi bi-camera-video-fill" style="font-size:1.8rem;color:#4d9fff;"></i>
                    </a>
                    {% else %}
                    <img src="{{ photo.url }}" class="photo-thumb" onclick="openLightbox('{{ photo.url }}')" alt="photo">
                    {% endif %}
                  {% endfor %}
                </div>
                <div class="mt-1" style="font-size:.72rem;color:#555;"><i class="bi bi-collection me-1"></i>{{ post.photos|length }} ảnh/video{% if post.created_at %} &middot; <i class="bi bi-clock me-1"></i>{{ post.created_at[:10] }}{% endif %}</div>
              </div>
              {% endfor %}
            {% else %}<div class="empty-state py-3"><i class="bi bi-inbox"></i>Chưa có bài viết. Nhấn <strong>Thêm bài</strong>.</div>{% endif %}
          </div>
        </div>
        {% endfor %}
      {% else %}
      <div class="album-card p-0">
        <div class="empty-state py-5">
          <i class="bi bi-folder-plus" style="font-size:3rem;color:var(--accent);"></i>
          <p class="mt-2 mb-3">Chưa có album nào.</p>
          <button class="btn btn-accent" data-bs-toggle="modal" data-bs-target="#createAlbumModal"><i class="bi bi-plus-lg me-1"></i>Tạo Album đầu tiên</button>
        </div>
      </div>
      {% endif %}
      {% if total_pages > 1 %}
      <div class="d-flex align-items-center justify-content-center gap-2 mt-3">
        {% if page > 1 %}
        <a href="/?page={{ page - 1 }}" class="btn btn-sm btn-outline-secondary"><i class="bi bi-chevron-left me-1"></i>Trang trước</a>
        {% else %}
        <button class="btn btn-sm btn-outline-secondary" disabled><i class="bi bi-chevron-left me-1"></i>Trang trước</button>
        {% endif %}
        <span style="font-size:.85rem;color:#aaa;">Trang {{ page }} / {{ total_pages }} &nbsp;({{ total_albums }} albums)</span>
        {% if page < total_pages %}
        <a href="/?page={{ page + 1 }}" class="btn btn-sm btn-outline-secondary">Trang sau<i class="bi bi-chevron-right ms-1"></i></a>
        {% else %}
        <button class="btn btn-sm btn-outline-secondary" disabled>Trang sau<i class="bi bi-chevron-right ms-1"></i></button>
        {% endif %}
      </div>
      {% endif %}
    </div>

    <!-- SCRIPT & ALBUM MANAGER SECTION -->
    <div class="section-page" id="section-script">
      <div class="page-header">
        <span class="page-title"><i class="bi bi-diagram-3"></i>Kịch bản &amp; Album</span>
        <span style="font-size:.78rem;color:#888;">Luồng tương tác đầy đủ từ /start đến kết thúc album</span>
      </div>
      <!-- Flow Visualization -->
      <div class="dash-card mb-4">
        <div class="dash-card-header"><span class="dash-card-title"><i class="bi bi-signpost-2 me-2" style="color:var(--accent);"></i>Luồng Kịch bản Tổng quan</span></div>
        <div class="dash-card-body">
          <div class="d-flex align-items-center gap-2 flex-wrap justify-content-center" style="font-size:.82rem;">
            <div class="text-center px-3 py-2 rounded" style="background:rgba(77,159,255,.1);border:1px dashed #4d9fff;min-width:96px;">
              <i class="bi bi-1-circle-fill d-block mb-1" style="color:#4d9fff;font-size:1.2rem;"></i>
              <div style="color:#4d9fff;font-weight:600;">Chào mừng</div>
              <div style="color:#888;font-size:.72rem;">/start → slogan → tin nhắn</div>
            </div>
            <i class="bi bi-arrow-right fs-4" style="color:#555;"></i>
            <div class="text-center px-3 py-2 rounded" style="background:rgba(0,200,83,.1);border:1px dashed #00c853;min-width:96px;">
              <i class="bi bi-2-circle-fill d-block mb-1" style="color:#00c853;font-size:1.2rem;"></i>
              <div style="color:#00c853;font-weight:600;">Danh sách Album</div>
              <div style="color:#888;font-size:.72rem;">{{ albums|length }} album đang có</div>
            </div>
            <i class="bi bi-arrow-right fs-4" style="color:#555;"></i>
            <div class="text-center px-3 py-2 rounded" style="background:rgba(255,193,7,.1);border:1px dashed #ffc107;min-width:96px;">
              <i class="bi bi-3-circle-fill d-block mb-1" style="color:#ffc107;font-size:1.2rem;"></i>
              <div style="color:#ffc107;font-weight:600;">Xem Album</div>
              <div style="color:#888;font-size:.72rem;">Bot gửi bài viết tuần tự</div>
            </div>
            <i class="bi bi-arrow-right fs-4" style="color:#555;"></i>
            <div class="text-center px-3 py-2 rounded" style="background:rgba(156,39,176,.1);border:1px dashed #ce93d8;min-width:96px;">
              <i class="bi bi-4-circle-fill d-block mb-1" style="color:#ce93d8;font-size:1.2rem;"></i>
              <div style="color:#ce93d8;font-weight:600;">Kết thúc Album</div>
              <div style="color:#888;font-size:.72rem;">Tin nhắn + nút Quay lại</div>
            </div>
          </div>
        </div>
      </div>
      <div class="row g-4">
        <!-- Part A: Welcome Script -->
        <div class="col-12 col-lg-6">
          <div class="dash-card h-100" style="border-color:#4d9fff33;">
            <div class="dash-card-header" style="border-color:#4d9fff33;">
              <span class="dash-card-title" style="color:#4d9fff;"><i class="bi bi-1-circle-fill me-2"></i>Bước 1 — Tin nhắn Chào mừng</span>
            </div>
            <div class="dash-card-body">
              <div class="mb-2" style="font-size:.8rem;color:#888;"><i class="bi bi-info-circle me-1"></i>Tin nhắn được gửi sau slogan khi người dùng gõ <code>/start</code>.</div>
              <div class="mb-3">
                <label class="form-label fw-semibold" style="font-size:.85rem;">Nội dung tin nhắn <span class="text-danger">*</span></label>
                <textarea id="sm-welcome-text" class="form-control" rows="4" placeholder="VD: Chào mừng bạn! 👋 Nhấn nút bên dưới để xem album..."></textarea>
              </div>
              <div class="mb-3">
                <label class="form-label fw-semibold" style="font-size:.85rem;">Nút bấm</label>
                <div id="sm-welcome-buttons" class="mb-2"></div>
                <div class="d-flex gap-2 flex-wrap">
                  <button type="button" class="btn btn-sm btn-outline-secondary" onclick="smAddBtn('welcome')"><i class="bi bi-plus-lg me-1"></i>Thêm nút</button>
                  <button type="button" class="btn btn-sm btn-outline-success" onclick="smAddAlbumListBtn('welcome')"><i class="bi bi-collection me-1"></i>Thêm nút "Xem Album"</button>
                </div>
              </div>
              <div class="d-flex gap-2 flex-wrap">
                <button class="btn btn-accent btn-sm" onclick="smSaveWelcome(this)"><i class="bi bi-floppy me-1"></i>Lưu</button>
                <button class="btn btn-sm btn-outline-secondary" onclick="showSection('config');showConfigTab('slogans')"><i class="bi bi-chat-quote me-1"></i>Sửa Slogan</button>
              </div>
            </div>
          </div>
        </div>
        <!-- Part B: Album List Preview -->
        <div class="col-12 col-lg-6">
          <div class="dash-card h-100" style="border-color:#00c85333;">
            <div class="dash-card-header" style="border-color:#00c85333;">
              <span class="dash-card-title" style="color:#00c853;"><i class="bi bi-2-circle-fill me-2"></i>Bước 2 — Danh sách Album (Động)</span>
              <button class="btn btn-sm btn-outline-success" onclick="showSection('albums')"><i class="bi bi-pencil me-1"></i>Quản lý Album</button>
            </div>
            <div class="dash-card-body">
              <div class="mb-2" style="font-size:.8rem;color:#888;"><i class="bi bi-info-circle me-1"></i>Bot tự động hiển thị các album này dưới dạng nút bấm. Quản lý trong mục <strong>Albums</strong>.</div>
              <div class="d-flex flex-wrap gap-2 mb-3">
                {% if albums %}
                  {% for album_id, album in albums.items() %}
                  <span style="background:rgba(0,200,83,.15);color:#00c853;border:1px solid #00c85333;border-radius:8px;padding:5px 12px;font-size:.82rem;">
                    <i class="bi bi-folder2 me-1"></i>{{ album.title if album.title else album_id }}
                    <span style="color:#666;font-size:.72rem;margin-left:4px;">({{ album.posts|length if album.posts else 0 }} bài)</span>
                  </span>
                  {% endfor %}
                {% else %}
                  <div style="font-size:.85rem;color:#666;"><i class="bi bi-folder-x me-1"></i>Chưa có album. <a href="#" onclick="showSection('albums')" style="color:#00c853;">Tạo ngay →</a></div>
                {% endif %}
              </div>
              <div class="p-2 rounded" style="background:rgba(255,255,255,.03);border:1px solid var(--border-color);font-size:.78rem;color:#777;">
                <i class="bi bi-lightbulb me-1" style="color:#ffc107;"></i>Người dùng nhấn nút album → Bot gửi tuần tự tất cả bài viết (ảnh/video + caption) của album đó.
              </div>
            </div>
          </div>
        </div>
        <!-- Part C: End-of-Album Script -->
        <div class="col-12">
          <div class="dash-card" style="border-color:#ce93d833;">
            <div class="dash-card-header" style="border-color:#ce93d833;">
              <span class="dash-card-title" style="color:#ce93d8;"><i class="bi bi-4-circle-fill me-2"></i>Bước 4 — Tin nhắn Kết thúc Album</span>
            </div>
            <div class="dash-card-body">
              <div class="mb-3" style="font-size:.8rem;color:#888;"><i class="bi bi-info-circle me-1"></i>Tin nhắn này được gửi <strong>sau khi bot gửi xong toàn bộ bài viết</strong> của một album. Nên có nút "Quay lại danh sách album".</div>
              <div class="row g-3">
                <div class="col-12 col-md-6">
                  <label class="form-label fw-semibold" style="font-size:.85rem;">Nội dung tin nhắn kết thúc</label>
                  <textarea id="sm-end-text" class="form-control" rows="4" placeholder="VD: Bạn đã xem xong album! Nhấn nút bên dưới để quay lại..."></textarea>
                </div>
                <div class="col-12 col-md-6">
                  <label class="form-label fw-semibold" style="font-size:.85rem;">Nút bấm</label>
                  <div id="sm-end-buttons" class="mb-2"></div>
                  <div class="d-flex gap-2 flex-wrap">
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="smAddBtn('end')"><i class="bi bi-plus-lg me-1"></i>Thêm nút</button>
                    <button type="button" class="btn btn-sm btn-outline-success" onclick="smAddAlbumListBtn('end')"><i class="bi bi-arrow-left-circle me-1"></i>Thêm nút Quay lại Album</button>
                  </div>
                </div>
              </div>
              <button class="btn btn-accent btn-sm mt-3" onclick="smSaveAlbumEnd(this)"><i class="bi bi-floppy me-1"></i>Lưu Tin nhắn Kết thúc</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- CONFIG SECTION -->
    <div class="section-page" id="section-config">
      <div class="page-header"><span class="page-title"><i class="bi bi-gear-fill"></i>Cấu hình Bot</span></div>
      <ul class="nav config-tabs mb-4" style="border-bottom:1px solid var(--border-color);">
        <li class="nav-item"><button class="nav-link active" id="tab-slogans-btn" onclick="showConfigTab('slogans')"><i class="bi bi-chat-quote me-1"></i>Slogan</button></li>
        <li class="nav-item"><button class="nav-link" id="tab-flow-btn" onclick="showConfigTab('flow')"><i class="bi bi-diagram-3 me-1"></i>Kịch bản Bot</button></li>
        <li class="nav-item"><button class="nav-link" id="tab-miniapp-btn" onclick="showConfigTab('miniapp')"><i class="bi bi-phone me-1"></i>Mini App</button></li>
      </ul>
      <!-- Slogans Tab -->
      <div id="config-tab-slogans">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
          <div class="d-flex align-items-center gap-3">
            <div class="form-check form-switch mb-0">
              <input class="form-check-input" type="checkbox" role="switch" id="sloganEnabled" onchange="toggleSloganEnabled(this)">
              <label class="form-check-label text-light" for="sloganEnabled" id="sloganEnabledLabel">Bật</label>
            </div>
          </div>
          <div class="d-flex gap-2">
            <button class="btn btn-sm btn-outline-secondary" onclick="showAddSloganModal()"><i class="bi bi-plus-lg me-1"></i>Thêm Slogan</button>
            <button class="btn btn-sm btn-accent" onclick="doSaveSlogans(this)"><i class="bi bi-floppy me-1"></i>Lưu</button>
          </div>
        </div>
        <div class="dash-card">
          <div class="dash-card-body pb-1" style="border-bottom:1px solid var(--border-color);"><div style="font-size:.82rem;color:#bbb;"><i class="bi bi-info-circle me-1"></i>Các câu slogan lần lượt gửi sau <code>/start</code>, sau đó <strong>tự xóa</strong>.</div></div>
          <div class="dash-card-body"><div id="sloganList"><div class="text-center py-4" style="color:#888;"><span class="spinner-border spinner-border-sm me-2" role="status"></span>Đang tải...</div></div></div>
        </div>
      </div>
      <!-- Flow Tab -->
      <div id="config-tab-flow" style="display:none;">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
          <span style="font-size:.82rem;color:#aaa;">Quản lý kịch bản tin nhắn tương tác</span>
          <button class="btn btn-sm btn-accent" onclick="showAddNodeModal()"><i class="bi bi-plus-lg me-1"></i>Thêm Kịch bản</button>
        </div>
        <div class="dash-card">
          <div class="dash-card-body pb-1" style="border-bottom:1px solid var(--border-color);"><div style="font-size:.82rem;color:#bbb;"><i class="bi bi-info-circle me-1"></i>Kịch bản <code>start</code> là tin nhắn đầu tiên khi người dùng gõ <code>/start</code>.</div></div>
          <div class="dash-card-body"><div id="flowNodesList"><div class="text-center py-4 text-muted"><span class="spinner-border spinner-border-sm me-2" role="status"></span>Đang tải...</div></div></div>
        </div>
      </div>
      <!-- Mini App Tab -->
      <div id="config-tab-miniapp" style="display:none;">
        <div class="dash-card">
          <div class="dash-card-header">
            <span class="dash-card-title"><i class="bi bi-phone me-2" style="color:var(--accent);"></i>Cài đặt Mini App Bridge</span>
          </div>
          <div class="dash-card-body">
            <p style="font-size:.85rem;color:#aaa;margin-bottom:14px;">
              Khi liên kết album hết hạn (sau 24h), người dùng sẽ thấy thông báo này.
              Nếu để trống sẽ dùng thông báo mặc định.
            </p>
            <label class="form-label" style="font-size:.82rem;">Thông báo hết hạn link</label>
            <textarea id="expiredWarningMsg" class="form-control mb-3" rows="3" style="background:var(--input-bg,#1a1a1a);color:#eee;border:1px solid var(--border-color);border-radius:8px;resize:vertical;">{{ expired_warning_message }}</textarea>
            <button class="btn btn-accent btn-sm" onclick="doSaveExpiredWarning(this)"><i class="bi bi-floppy me-1"></i>Lưu thông báo</button>
          </div>
        </div>
      </div>
    </div>

    <!-- SYSTEM SECTION -->
    <div class="section-page" id="section-system">
      <div class="page-header"><span class="page-title"><i class="bi bi-shield-fill"></i>Backup &amp; Hệ thống</span></div>
      <div class="row g-3">
        <div class="col-12 col-md-6">
          <div class="dash-card">
            <div class="dash-card-header"><span class="dash-card-title"><i class="bi bi-cloud-arrow-up me-2" style="color:var(--accent);"></i>Sao lưu dữ liệu</span></div>
            <div class="dash-card-body">
              <p style="font-size:.85rem;color:#aaa;">Sao lưu toàn bộ: Albums, IDs, Slogans, Cấu hình...</p>
              <div class="d-flex flex-wrap gap-2 mb-3">
                <a href="/backup/download" class="btn btn-accent btn-sm"><i class="bi bi-download me-1"></i>Tải Backup Ngay</a>
                {% if role == 'owner' %}<button class="btn btn-sm btn-outline-info" id="btnBackupCloud" onclick="doBackup(this)"><i class="bi bi-cloud-arrow-up me-1"></i>Lưu lên Cloudinary</button>{% endif %}
              </div>
              <div style="font-size:.78rem;color:#666;padding:10px;background:rgba(255,255,255,.03);border-radius:8px;">
                <i class="bi bi-clock-fill me-1" style="color:var(--accent);"></i><strong>Tự động:</strong> mỗi ngày lúc <strong>0:01 sáng (Giờ Việt Nam)</strong> — APScheduler
              </div>
            </div>
          </div>
        </div>
        {% if role == 'owner' %}
        <div class="col-12 col-md-6">
          <div class="dash-card">
            <div class="dash-card-header"><span class="dash-card-title"><i class="bi bi-cloud-arrow-down me-2" style="color:#4d9fff;"></i>Khôi phục dữ liệu</span></div>
            <div class="dash-card-body">
              <p style="font-size:.85rem;color:#aaa;">Khôi phục từ bản sao lưu gần nhất trên Cloudinary. <strong class="text-danger">Dữ liệu hiện tại sẽ bị ghi đè!</strong></p>
              <button class="btn btn-sm btn-outline-danger" id="btnRestore" onclick="doRestore(this)"><i class="bi bi-cloud-arrow-down me-1"></i>Khôi phục</button>
            </div>
          </div>
        </div>
        {% endif %}
        <div class="col-12 col-md-6">
          <div class="dash-card">
            <div class="dash-card-header"><span class="dash-card-title"><i class="bi bi-clock-fill me-2" style="color:#ffc107;"></i>Cài đặt gửi tự động</span></div>
            <div class="dash-card-body">
              <p style="font-size:.85rem;color:#aaa;">Bot tự động gửi album mới nhất vào giờ bạn cài đặt (Giờ Việt Nam UTC+7).</p>
              <div class="row g-2 mb-3">
                <div class="col-6"><label class="form-label" style="font-size:.82rem;">Giờ (0&#8211;23)</label><input type="number" id="scheduleHour" class="form-control form-control-sm" min="0" max="23" value="{{ cfg.hour | default(8) }}"></div>
                <div class="col-6"><label class="form-label" style="font-size:.82rem;">Phút (0&#8211;59)</label><input type="number" id="scheduleMinute" class="form-control form-control-sm" min="0" max="59" value="{{ cfg.minute | default(0) }}"></div>
              </div>
              <button class="btn btn-primary btn-sm" onclick="doSaveSchedule(this)"><i class="bi bi-check-lg me-1"></i>Lưu cài đặt</button>
            </div>
          </div>
        </div>
        <div class="col-12 col-md-6">
          <div class="dash-card">
            <div class="dash-card-header"><span class="dash-card-title"><i class="bi bi-megaphone-fill me-2" style="color:#00c853;"></i>Broadcast Subscribers</span></div>
            <div class="dash-card-body">
              <p style="font-size:.85rem;color:#aaa;">Gửi tới tất cả người đã bấm /start. ({{ subs|length }} người đăng ký)<br><small>Hỗ trợ text, ảnh, video và nút bấm inline.</small></p>
              <button class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#broadcastModal"><i class="bi bi-send-fill me-1"></i>Gửi Thông Báo</button>
              <div id="broadcastSubsProgress" class="mt-3" style="display:none;">
                <div class="d-flex justify-content-between mb-1" style="font-size:.78rem;"><span id="bspLabel">Đang gửi...</span><span id="bspPercent">0%</span></div>
                <div class="progress mb-2"><div class="progress-bar progress-bar-striped progress-bar-animated bg-success" id="bspBar" style="width:0%;"></div></div>
                <div class="d-flex gap-3 flex-wrap mb-2" style="font-size:.76rem;color:#aaa;">
                  <span>&#9989; Thành công: <strong id="bspSuccess">0</strong></span>
                  <span>&#10060; Thất bại: <strong id="bspFail">0</strong></span>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-12">
          <div class="dash-card">
            <div class="dash-card-header"><span class="dash-card-title"><i class="bi bi-broadcast me-2" style="color:#ce93d8;"></i>Broadcast All (Active IDs)</span></div>
            <div class="dash-card-body">
              <p style="font-size:.85rem;color:#aaa;">Gửi tới <strong>tất cả ID active</strong> trong database bằng <strong>tất cả bot</strong>. Hỗ trợ text, ảnh, video và nút bấm inline.</p>
              <button class="btn btn-sm btn-purple" data-bs-toggle="modal" data-bs-target="#broadcastAllModal" style="background:rgba(156,39,176,.8);border:none;color:#fff;font-weight:600;"><i class="bi bi-broadcast me-1"></i>Mở Broadcast All</button>
              <div id="broadcastAllProgress" class="mt-3" style="display:none;">
                <div class="d-flex justify-content-between mb-1" style="font-size:.78rem;"><span id="bapLabel">Đang gửi...</span><span id="bapPercent">0%</span></div>
                <div class="progress mb-2"><div class="progress-bar progress-bar-striped progress-bar-animated" id="bapBar" style="width:0%;background:rgba(156,39,176,.8);"></div></div>
                <div class="d-flex gap-3 flex-wrap mb-2" style="font-size:.76rem;color:#aaa;">
                  <span>&#9989; Thành công: <strong id="bapSuccess">0</strong></span>
                  <span>&#10060; Thất bại: <strong id="bapFail">0</strong></span>
                </div>
                <div id="bapBotResults" style="display:none;">
                  <div style="font-size:.76rem;font-weight:600;color:#aaa;margin-bottom:4px;"><i class="bi bi-robot me-1"></i>Kết quả từng Bot:</div>
                  <div id="bapBotResultsTable"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

  </main>
</div><!-- /layout -->

<!-- Lightbox -->
<div id="lightbox" onclick="closeLightbox()"><span class="close-lb" onclick="closeLightbox()">&times;</span><img id="lightbox-img" src="" alt="preview"></div>

<!-- Toast container -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index:9500;" id="toastContainer"></div>

<!-- Broadcast Subscribers Modal -->
<div class="modal fade" id="broadcastModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title"><i class="bi bi-megaphone-fill me-2" style="color:#00c853;"></i>Gửi Thông Báo All &#128226;</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <div class="mb-3">
          <label class="form-label fw-semibold"><i class="bi bi-chat-left-text me-1" style="color:var(--accent);"></i>Nội dung tin nhắn</label>
          <textarea id="broadcastMessage" class="form-control" rows="4" placeholder="Nhập nội dung..."></textarea>
          <div class="text-muted mt-1" style="font-size:.8rem;"><i class="bi bi-info-circle me-1"></i>Gửi tới tất cả người đã bấm /start + tất cả ID đã lọc là <strong>active</strong>.</div>
        </div>
        <div class="mb-3">
          <label class="form-label fw-semibold"><i class="bi bi-image me-1" style="color:#4d9fff;"></i>Loại Media</label>
          <select id="bcMediaType" class="form-select" onchange="toggleBcMedia(this.value)">
            <option value="none">Không có (chỉ text)</option>
            <option value="image">&#128247; Hình ảnh</option>
            <option value="video">&#127916; Video</option>
          </select>
        </div>
        <div id="bcMediaUrlRow" class="mb-3" style="display:none;">
          <label class="form-label fw-semibold"><i class="bi bi-upload me-1" style="color:#4d9fff;"></i>Tải lên tệp <span class="badge bg-primary ms-1" style="font-size:.7rem;">Ưu tiên</span></label>
          <input type="file" id="bcMediaFile" class="form-control mb-2" accept="image/*,video/*">
          <label class="form-label fw-semibold"><i class="bi bi-link-45deg me-1" style="color:#4d9fff;"></i>Hoặc nhập URL</label>
          <input type="url" id="bcMediaUrl" class="form-control" placeholder="https://... (Cloudinary, direct URL)">
          <div class="form-text text-muted">Tải lên file sẽ được ưu tiên hơn URL. Hỗ trợ ảnh và video.</div>
        </div>
        <div class="mb-2">
          <label class="form-label fw-semibold"><i class="bi bi-grid-1x2 me-1" style="color:var(--accent);"></i>Nút bấm Inline <span class="text-muted">(tuỳ chọn)</span></label>
          <div id="bcBtnList" class="mb-2"></div>
          <button type="button" class="btn btn-sm btn-outline-secondary" onclick="bcAddBtn()"><i class="bi bi-plus-lg me-1"></i>Thêm nút</button>
          <div class="form-text text-muted mt-1">Mỗi nút có thể mở link (URL) hoặc gửi callback_data.</div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
        <button type="button" class="btn btn-success" id="btnBroadcast" onclick="doBroadcast(this)"><i class="bi bi-send-fill me-1"></i>Gửi ngay</button>
      </div>
    </div>
  </div>
</div>

