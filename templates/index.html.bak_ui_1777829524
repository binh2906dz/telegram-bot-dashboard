          <input type="file" id="baMediaFile" class="form-control mb-2" accept="image/*,video/*">
          <label class="form-label fw-semibold"><i class="bi bi-link-45deg me-1" style="color:#4d9fff;"></i>Hoặc nhập URL</label>
          <input type="url" id="baMediaUrl" class="form-control" placeholder="https://... (Cloudinary, direct URL)">
